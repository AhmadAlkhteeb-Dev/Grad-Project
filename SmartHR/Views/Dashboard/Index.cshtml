@model List<SmartHR_Platform.Models.EmployeeRequest>
@{
    var supportTickets = ViewBag.SupportTickets as List<SmartHR_Platform.Controllers.SupportTicketItem> ?? new();
    Layout = null;
    string currentRole = ViewBag.CurrentRole ?? "Employee";
    string currentEmployeeName = ViewBag.CurrentEmployeeName ?? "سارة العلي";
    bool canViewCompanyAnalytics = ViewBag.CanViewCompanyAnalytics ?? false;
    bool canViewAuditTrail = ViewBag.CanViewAuditTrail ?? false;

    int companySatisfaction = ViewBag.CompanySatisfactionScore ?? 92;
    bool isManagerSatisfied = ViewBag.IsManagerSatisfied ?? true;
    string managerFeedbackSummary = ViewBag.ManagerFeedbackSummary ?? "";

    int pendingCount = ViewBag.PendingCount ?? 0;
    int approvedCount = ViewBag.ApprovedCount ?? 0;
    int rejectedCount = ViewBag.RejectedCount ?? 0;
    int anonymousCount = ViewBag.AnonymousCount ?? 0;
    var auditLogs = ViewBag.AuditLogs as List<SmartHR_Platform.Models.AuditLogEntry> ?? new();
    var allHistoryRequests = ViewBag.AllRequestsForHistory as List<SmartHR_Platform.Models.EmployeeRequest> ?? Model;
    var recentDecisions = ViewBag.RecentDecisions as List<SmartHR_Platform.Controllers.RecentDecisionItem> ?? new();

    var priorityRequests = Model
        .Where(r => r.Status == SmartHR_Platform.Models.RequestStatus.Pending &&
                   (r.Type == SmartHR_Platform.Models.RequestType.Resignation ||
                    r.Type == SmartHR_Platform.Models.RequestType.BranchTransfer ||
                    r.IsAnonymous))
        .ToList();

    var departments = new[]
    {
        new { Name = "تطوير البرمجيات", Stability = "91%", Risk = "مستقر", Criteria = "التزام المهام 94% + استقرار الفريق 89%" },
        new { Name = "المبيعات", Stability = "79%", Risk = "متوسط", Criteria = "تحقيق الأهداف الفصلية 81% + معدل دوران متوسط" },
        new { Name = "العمليات", Stability = "88%", Risk = "مستقر", Criteria = "زمن إنجاز العمليات SLA 90% + انضباط عالٍ" },
        new { Name = "الدعم الفني", Stability = "76%", Risk = "يحتاج متابعة", Criteria = "ضغط المناوبات المسائية + سرعة إغلاق التذاكر" }
    };

    string GetTypeArabic(SmartHR_Platform.Models.RequestType t) => t switch
    {
        SmartHR_Platform.Models.RequestType.AnnualLeave => "طلب إجازة",
        SmartHR_Platform.Models.RequestType.SalaryAdvance => "طلب سلفة مالية",
        SmartHR_Platform.Models.RequestType.ExitPermission => "إذن خروج",
        SmartHR_Platform.Models.RequestType.SalaryRaise => "طلب زيادة راتب",
        SmartHR_Platform.Models.RequestType.BranchTransfer => "نقل فرع",
        SmartHR_Platform.Models.RequestType.Complaint => "ملاحظة إدارية",
        SmartHR_Platform.Models.RequestType.AnonymousWhistleblowing => "بلاغ سري",
        SmartHR_Platform.Models.RequestType.Resignation => "استقالة",
        _ => t.ToString()
    };

    // دالة فحص تعارض الإجازات مع طلب إجازة آخر في نفس الفترة
    bool HasLeaveConflict(SmartHR_Platform.Models.EmployeeRequest candidate)
    {
        if (candidate.Type != SmartHR_Platform.Models.RequestType.AnnualLeave || !candidate.StartDate.HasValue)
            return false;

        var cStart = candidate.StartDate.Value.Date;
        var cEnd = (candidate.EndDate ?? candidate.StartDate).Value.Date;

        return allHistoryRequests.Any(other =>
            other.Id != candidate.Id &&
            other.Type == SmartHR_Platform.Models.RequestType.AnnualLeave &&
            other.Status != SmartHR_Platform.Models.RequestStatus.Rejected &&
            other.Status != SmartHR_Platform.Models.RequestStatus.Cancelled &&
            other.StartDate.HasValue &&
            cStart <= (other.EndDate ?? other.StartDate).Value.Date &&
            cEnd >= other.StartDate.Value.Date);
    }
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة التحكم | SmartHR Enterprise</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #F1F5F9;
            color: #0F172A;
        }

        .panel {
            background: #FFFFFF;
            border: 1px solid #E2E8F0;
            box-shadow: 0 2px 12px rgba(15, 23, 42, 0.03);
        }

        .card-item {
            background: #F8FAFC;
            border: 1px solid #E2E8F0;
            transition: all 0.2s ease;
        }

            .card-item:hover {
                border-color: #93C5FD;
                background: #FFFFFF;
            }

        .primary-btn {
            background: #1D4ED8;
            color: #FFFFFF;
            transition: all 0.2s ease;
        }

            .primary-btn:hover {
                background: #1E40AF;
            }
    </style>
</head>
<body class="min-h-screen flex overflow-x-hidden">

    <!-- القائمة الجانبية -->
    <aside class="w-72 bg-white border-l border-slate-200 p-6 flex flex-col justify-between z-20 shrink-0">
        <div>
            <div class="flex items-center gap-3 mb-7 pb-5 border-b border-slate-200">
                <div class="w-11 h-11 rounded-xl bg-blue-700 flex items-center justify-center font-black text-white text-sm shadow-sm">HR</div>
                <div>
                    <h1 class="font-black text-base text-slate-900">SmartHR Enterprise</h1>
                    <p class="text-[11px] text-slate-500 font-semibold">حوكمة الصلاحيات والبيانات</p>
                </div>
            </div>

            <a href="/Dashboard/PublicHome" class="flex items-center justify-between px-4 py-2.5 mb-6 rounded-xl bg-slate-100 hover:bg-slate-200 text-xs font-bold text-slate-700 transition">
                <span>الصفحة الرئيسية للزوار</span>
                <span>↗</span>
            </a>

            <p class="text-[11px] text-slate-400 mb-3 font-bold">بوابات النظام والصلاحيات (RBAC):</p>
            <nav class="space-y-2">
                <a href="/Dashboard/Index?role=Employee" class="flex items-center justify-between px-4 py-3 rounded-xl transition text-xs font-bold @(currentRole == "Employee" ? "bg-blue-700 text-white shadow-sm" : "text-slate-600 hover:bg-slate-100")">
                    <span>01. بوابة الموظف</span>
                    <span class="text-[10px] opacity-80">Employee</span>
                </a>
                <a href="/Dashboard/Index?role=Manager" class="flex items-center justify-between px-4 py-3 rounded-xl transition text-xs font-bold @(currentRole == "Manager" ? "bg-blue-700 text-white shadow-sm" : "text-slate-600 hover:bg-slate-100")">
                    <span>02. لوحة المدير المباشر</span>
                    <span class="text-[10px] opacity-80">Manager</span>
                </a>
                <a href="/Dashboard/Index?role=HR" class="flex items-center justify-between px-4 py-3 rounded-xl transition text-xs font-bold @(currentRole == "HR" ? "bg-blue-700 text-white shadow-sm" : "text-slate-600 hover:bg-slate-100")">
                    <span>03. الموارد البشرية</span>
                    <span class="text-[10px] opacity-80">HR</span>
                </a>
                <a href="/Dashboard/Index?role=Admin" class="flex items-center justify-between px-4 py-3 rounded-xl transition text-xs font-bold @(currentRole == "Admin" ? "bg-blue-700 text-white shadow-sm" : "text-slate-600 hover:bg-slate-100")">
                    <span>04. سجل التدقيق الأمني</span>
                    <span class="text-[10px] opacity-80">Admin</span>
                </a>
            </nav>
        </div>

        <div class="bg-blue-50/80 border border-blue-100 p-4 rounded-xl text-xs space-y-1.5">
            <div class="flex items-center justify-between">
                <span class="text-slate-600 font-semibold">عزل البيانات:</span>
                <span class="text-emerald-700 font-extrabold">مفعل حسب الدور</span>
            </div>
            <p class="text-slate-500 text-[11px] leading-relaxed">كل دور يرى فقط البيانات المخول له الاطلاع عليها.</p>
        </div>
    </aside>

    <!-- المحتوى الرئيسي -->
    <main class="flex-1 p-8 overflow-y-auto">
        <!-- رسالة التأكيد الفوري اللحظي -->
        <div id="liveToast" class="hidden fixed bottom-6 left-6 z-50 bg-slate-900 text-white px-5 py-3.5 rounded-2xl shadow-2xl border border-slate-700 text-xs font-bold flex items-center gap-3">
            <span id="liveToastIcon" class="w-6 h-6 rounded-full bg-emerald-500 text-white flex items-center justify-center font-black">✓</span>
            <span id="liveToastText">تم تنفيذ الإجراء بنجاح.</span>
        </div>

        <header class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-wrap justify-between items-center gap-4 mb-6">
            <div>
                <h2 class="text-xl font-black text-slate-900">
                    @(currentRole == "Employee" ? $"بوابة الموظف ({currentEmployeeName}) — الخدمات الذاتية والطلبات" :
                                        currentRole == "Manager" ? "لوحة المدير المباشر — مراجعة طلبات الفريق" :
                                        currentRole == "HR" ? "إدارة الموارد البشرية — مؤشرات الشركة والتقارير" :
                                        "مدير النظام — سجل التدقيق الأمني (Audit Trail)")
                </h2>
                <p class="text-xs text-slate-500 mt-1">
                    @(currentRole == "Employee" ? "تقديم الإجازات، السلف، أذونات الخروج، ومتابعة مسار الطلبات وتقييم الأداء الشخصي." :
                                        currentRole == "Manager" ? "متابعة طلبات الفريق، التحقق من تعارض الإجازات، والموافقة الفردية أو الجماعية." :
                                        currentRole == "HR" ? "تحليلات استقرار الكفاءات، التقارير التنفيذية، والبلاغات السرية." :
                                        "مراقبة حركات النظام والصلاحيات وسجل التدقيق.")
                </p>
            </div>

            <div class="flex items-center gap-3">
                @if (currentRole == "Employee")
                {
                    <button type="button" onclick="activateWhistleblower()" class="px-4 py-2.5 rounded-xl bg-amber-50 hover:bg-amber-100 border border-amber-200 text-xs font-bold text-amber-800 transition">
                        بلاغ سري للـ HR 🔒
                    </button>
                }
                else if (currentRole == "Manager")
                {
                    <button type="button" onclick="filterRequests('Pending')" class="px-4 py-2.5 rounded-xl primary-btn text-xs font-bold">
                        المعلقة (<span class="pending-counter-val">@pendingCount</span>)
                    </button>
                }
                else if (currentRole == "HR")
                {
                    <a href="/Dashboard/ExportExecutiveReport" class="px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-xs font-bold text-white transition">
                        تصدير التقرير 📥
                    </a>
                }

                @if (currentRole == "Manager" || currentRole == "HR")
                {
                    <div class="relative">
                        <button type="button" onclick="toggleNotifications()" class="w-11 h-11 rounded-xl bg-slate-100 hover:bg-slate-200 border border-slate-200 flex items-center justify-center text-slate-700 transition relative">
                            🔔
                            <span id="bellBadge" class="@(pendingCount > 0 ? "" : "hidden") absolute -top-1.5 -right-1.5 w-5 h-5 bg-rose-600 text-white text-[10px] font-black rounded-full flex items-center justify-center pending-counter-val">@pendingCount</span>
                        </button>

                        <div id="notifDropdown" class="hidden absolute left-0 mt-3 w-80 bg-white p-4 rounded-2xl shadow-xl border border-slate-200 z-50">
                            <div class="flex justify-between items-center mb-3 pb-2 border-b border-slate-100">
                                <span class="font-bold text-xs text-slate-900">الطلبات المعلقة</span>
                                <span class="text-[10px] bg-amber-100 text-amber-800 px-2 py-0.5 rounded-md font-bold"><span class="pending-counter-val">@pendingCount</span> معلق</span>
                            </div>
                            <div class="space-y-2 max-h-60 overflow-y-auto">
                                @if (pendingCount == 0)
                                {
                                    <p class="text-xs text-slate-400 text-center py-4">لا توجد طلبات معلقة.</p>
                                }
                                @foreach (var req in Model.Where(r => r.Status == SmartHR_Platform.Models.RequestStatus.Pending))
                                {
                                    <div id="notif-item-@req.Id" class="bg-slate-50 p-3 rounded-xl border border-slate-200 text-xs">
                                        <div class="flex justify-between">
                                            <span class="font-bold text-blue-700">#@req.Id - @GetTypeArabic(req.Type)</span>
                                            <span class="text-[10px] text-slate-500">@req.Department</span>
                                        </div>
                                        <p class="text-slate-600 mt-1 truncate">@req.Details</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <div class="bg-blue-50 px-4 py-2 rounded-xl border border-blue-100">
                    <p class="text-[10px] text-slate-500">الدور النشط</p>
                    <p class="text-xs font-extrabold text-blue-700">@currentRole</p>
                </div>
            </div>
        </header>

        <!-- كروت الإحصاءات المرتبطة بالفلترة الفورية (للمدير والـ HR) -->
        @if (canViewCompanyAnalytics)
        {
            <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
                <button type="button" onclick="@(currentRole == "Manager" ? "filterRequests('All')" : "")" class="text-right panel p-5 rounded-2xl border-r-4 border-r-blue-600 hover:border-blue-400 transition">
                    <p class="text-xs text-slate-500 font-bold">إجمالي الطلبات (انقر للكل)</p>
                    <div class="flex items-end justify-between mt-2">
                        <span class="text-2xl font-black text-slate-900">@Model.Count</span>
                        <span class="text-[11px] text-slate-500">مقبول: <strong id="statApproved">@approvedCount</strong> | مرفوض: <strong id="statRejected">@rejectedCount</strong></span>
                    </div>
                </button>

                <button type="button" onclick="@(currentRole == "Manager" ? "filterRequests('Pending')" : "")" class="text-right panel p-5 rounded-2xl border-r-4 border-r-amber-500 hover:border-amber-400 transition">
                    <p class="text-xs text-slate-500 font-bold">الطلبات المعلقة (انقر للفلترة)</p>
                    <div class="flex items-end justify-between mt-2">
                        <span class="text-2xl font-black text-amber-600 pending-counter-val">@pendingCount</span>
                        <span class="text-[11px] text-amber-700 font-semibold">هدف الرد: 48 ساعة</span>
                    </div>
                </button>

                <div class="panel p-5 rounded-2xl border-r-4 border-r-emerald-600" title="تُحسب النسبة بناءً على: الالتزام بالحضور والمهام (40%)، سرعة الإنجاز (35%)، واستقرار الفريق (25%).">
                    <div class="flex items-center justify-between">
                        <p class="text-xs text-slate-500 font-bold">مؤشر الاستقرار والمهارات</p>
                        <span class="text-[10px] bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-full font-bold cursor-help" title="تُحسب النسبة بناءً على: الالتزام بالمهام (40%)، سرعة الإنجاز (35%)، واستقرار الفريق (25%).">كيف تُحسب؟ ⓘ</span>
                    </div>
                    <div class="flex items-end justify-between mt-2">
                        <span class="text-2xl font-black text-emerald-600">88.4%</span>
                        <span class="text-[11px] text-slate-500 font-semibold">أداء ومهارات الفريق</span>
                    </div>
                    <p class="text-[10px] text-slate-400 mt-1.5">المعايير: إنجاز المهام (40%)، SLA (35%)، استقرار الفريق (25%).</p>
                </div>

                @if (currentRole == "Manager")
                {
                    <button type="button" onclick="filterRequests('Rejected')" class="text-right panel p-5 rounded-2xl border-r-4 border-r-rose-600 hover:border-rose-400 transition">
                        <p class="text-xs text-slate-500 font-bold">الطلبات المرفوضة (انقر للفلترة)</p>
                        <div class="flex items-end justify-between mt-2">
                            <span id="statRejectedCard" class="text-2xl font-black text-rose-600">@rejectedCount</span>
                            <span class="text-[11px] text-rose-700 font-semibold">مراجعة الأسباب</span>
                        </div>
                    </button>
                }
                else
                {
                    <div class="panel p-5 rounded-2xl border-r-4 border-r-indigo-600">
                        <p class="text-xs text-slate-500 font-bold">البلاغات السرية المحمية</p>
                        <div class="flex items-end justify-between mt-2">
                            <span class="text-2xl font-black text-indigo-700">@anonymousCount</span>
                            <span class="text-[11px] text-slate-500">مجهولة المصدر</span>
                        </div>
                    </div>
                }
            </section>

            <section class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-8">
                <div class="lg:col-span-6 panel p-5 rounded-2xl">
                    <div class="flex justify-between items-center mb-3">
                        <h3 class="font-extrabold text-sm text-slate-900">مقارنة المهارات والأداء واستقرار الأقسام</h3>
                        <span class="text-[11px] bg-slate-100 text-slate-600 px-2.5 py-0.5 rounded-full font-semibold">معايير الأداء</span>
                    </div>
                    <p class="text-[11px] text-slate-500 bg-slate-50 p-2.5 rounded-lg border border-slate-200/70 mb-3">
                        <strong>آلية الحساب:</strong> تعتمد النسبة على تقييم جودة التسليم، الالتزام بالمواعيد، ومعدل بقاء الكفاءات خلال الربع الحالي.
                    </p>
                    <div class="overflow-x-auto">
                        <table class="w-full text-right text-xs">
                            <thead>
                                <tr class="border-b border-slate-200 text-slate-500">
                                    <th class="py-2 font-bold">القسم</th>
                                    <th class="py-2 font-bold">النسبة</th>
                                    <th class="py-2 font-bold">معيار التقييم</th>
                                    <th class="py-2 font-bold">الحالة</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var dept in departments)
                                {
                                    <tr>
                                        <td class="py-2.5 font-bold text-slate-800">@dept.Name</td>
                                        <td class="py-2.5 font-extrabold text-blue-700">@dept.Stability</td>
                                        <td class="py-2.5 text-[11px] text-slate-500">@dept.Criteria</td>
                                        <td class="py-2.5">
                                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold @(dept.Risk == "مستقر" ? "bg-emerald-100 text-emerald-700" : "bg-amber-100 text-amber-800")">
                                                @dept.Risk
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="lg:col-span-6 panel p-5 rounded-2xl">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="font-extrabold text-sm text-slate-900">حالات ذات أولوية للمتابعة</h3>
                        <span class="px-2.5 py-0.5 rounded-full bg-rose-100 text-rose-700 text-[10px] font-bold">@priorityRequests.Count حالات</span>
                    </div>
                    <div class="space-y-2.5 max-h-52 overflow-y-auto">
                        @if (!priorityRequests.Any())
                        {
                            <p class="text-xs text-slate-400 py-6 text-center">لا توجد حالات حرجة معلقة حالياً.</p>
                        }
                        @foreach (var item in priorityRequests)
                        {
                            <div class="card-item p-3 rounded-xl flex justify-between items-center gap-2">
                                <div class="min-w-0">
                                    <p class="text-xs font-bold text-slate-900 truncate">@item.EmployeeName — <span class="text-blue-700">@GetTypeArabic(item.Type)</span></p>
                                    <p class="text-[11px] text-slate-500 truncate">@item.Department • @item.Details</p>
                                </div>
                                <button type="button" onclick='openInspectModal(@item.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.EmployeeName)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.Department)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(GetTypeArabic(item.Type))), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.Status.ToString())), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.Details)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.ManagerNote ?? "بانتظار المراجعة")), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.CreatedAt.ToString("yyyy-MM-dd HH:mm"))))' class="shrink-0 px-3 py-1.5 rounded-lg bg-white hover:bg-blue-50 border border-slate-200 text-[11px] font-bold text-blue-700">
                                    معاينة
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </section>
        }

        <!-- ==================== 1. بوابة الموظف ==================== -->
        @if (currentRole == "Employee")
        {
            <section class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                <div class="panel p-5 rounded-2xl border-r-4 border-r-emerald-600">
                    <div class="flex justify-between items-center mb-2">
                        <p class="text-xs text-slate-500 font-bold">نسبة رضا الشركة عن أدائك</p>
                        <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold">تقييم دوري</span>
                    </div>
                    <div class="flex items-end justify-between mb-2">
                        <span class="text-3xl font-black text-emerald-600">@companySatisfaction%</span>
                        <span class="text-[11px] text-slate-500">مستوى ممتاز</span>
                    </div>
                    <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                        <div class="h-full bg-emerald-600 rounded-full" style="width: @companySatisfaction%"></div>
                    </div>
                </div>

                <div class="panel p-5 rounded-2xl border-r-4 @(isManagerSatisfied ? "border-r-blue-600" : "border-r-amber-500")">
                    <div class="flex justify-between items-center mb-2">
                        <p class="text-xs text-slate-500 font-bold">مؤشر رضا المدير المباشر</p>
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold @(isManagerSatisfied ? "bg-blue-100 text-blue-800" : "bg-amber-100 text-amber-800")">
                            @(isManagerSatisfied ? "المدير راضٍ عن أدائك ✓" : "يحتاج إلى تحسين")
                        </span>
                    </div>
                    <p class="text-xs text-slate-700 font-semibold leading-relaxed mt-2">@managerFeedbackSummary</p>
                </div>

                <div class="panel p-5 rounded-2xl border-r-4 border-r-indigo-600">
                    <p class="text-xs text-slate-500 font-bold">ملخص طلباتك الشخصية</p>
                    <div class="grid grid-cols-3 gap-2 mt-3 text-center">
                        <div class="bg-amber-50 p-2 rounded-xl">
                            <span class="block text-base font-black text-amber-700">@pendingCount</span>
                            <span class="text-[10px] text-amber-800 font-bold">معلق</span>
                        </div>
                        <div class="bg-emerald-50 p-2 rounded-xl">
                            <span class="block text-base font-black text-emerald-700">@approvedCount</span>
                            <span class="text-[10px] text-emerald-800 font-bold">مقبول</span>
                        </div>
                        <div class="bg-rose-50 p-2 rounded-xl">
                            <span class="block text-base font-black text-rose-700">@rejectedCount</span>
                            <span class="text-[10px] text-rose-800 font-bold">مرفوض</span>
                        </div>
                    </div>
                </div>
            </section>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-8">
                <div id="employeeFormCard" class="lg:col-span-5 panel p-6 rounded-2xl">
                    <h3 class="font-extrabold text-slate-900 text-base mb-4">تقديم طلب جديد</h3>
                    <form asp-action="SubmitRequest" method="post" enctype="multipart/form-data" class="space-y-4">
                        <div id="empNameField">
                            <label class="block text-xs text-slate-700 mb-1.5 font-bold">اسم الموظف</label>
                            <input type="text" name="EmployeeName" value="@currentEmployeeName" required class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-xs focus:border-blue-600 focus:bg-white outline-none" />
                        </div>

                        <div>
                            <label class="block text-xs text-slate-700 mb-1.5 font-bold">القسم الوظيفي</label>
                            <select name="Department" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-xs focus:border-blue-600 focus:bg-white outline-none">
                                <option value="تطوير البرمجيات">تطوير البرمجيات</option>
                                <option value="المبيعات">المبيعات</option>
                                <option value="العمليات">العمليات</option>
                                <option value="الدعم الفني">الدعم الفني</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-xs text-slate-700 mb-1.5 font-bold">نوع الطلب</label>
                            <select name="Type" id="requestTypeSelect" onchange="handleRequestTypeChange()" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-xs focus:border-blue-600 focus:bg-white outline-none">
                                <option value="AnnualLeave">طلب إجازة (تحديد التاريخ والسبب)</option>
                                <option value="SalaryAdvance">طلب سلفة مالية</option>
                                <option value="ExitPermission">إذن خروج أثناء الدوام</option>
                                <option value="SalaryRaise">طلب زيادة راتب</option>
                                <option value="BranchTransfer">طلب نقل إلى فرع آخر</option>
                                <option value="AnonymousWhistleblowing">بلاغ سري للـ HR (مجهول المصدر)</option>
                            </select>
                        </div>

                        <div id="dateRangeFields" class="grid grid-cols-2 gap-3 bg-blue-50/60 p-3 rounded-xl border border-blue-100">
                            <div>
                                <label class="block text-[11px] text-slate-700 mb-1 font-bold">من تاريخ</label>
                                <input type="date" name="StartDate" class="w-full bg-white border border-slate-300 rounded-lg p-2 text-xs text-slate-900 outline-none" />
                            </div>
                            <div id="endDateWrapper">
                                <label class="block text-[11px] text-slate-700 mb-1 font-bold">إلى تاريخ</label>
                                <input type="date" name="EndDate" class="w-full bg-white border border-slate-300 rounded-lg p-2 text-xs text-slate-900 outline-none" />
                            </div>
                            <div id="exitTimeWrapper" class="hidden col-span-2">
                                <label class="block text-[11px] text-slate-700 mb-1 font-bold">ساعة الخروج والعودة</label>
                                <input type="text" name="ExitTime" placeholder="مثال: 11:00 ص - 01:00 م" class="w-full bg-white border border-slate-300 rounded-lg p-2 text-xs text-slate-900 outline-none" />
                            </div>
                        </div>

                        <div id="advanceAmountField" class="hidden bg-emerald-50/70 p-3 rounded-xl border border-emerald-100">
                            <label class="block text-[11px] text-slate-700 mb-1 font-bold">قيمة السلفة المطلوبة (دينار)</label>
                            <input type="number" step="0.01" name="AdvanceAmount" placeholder="مثال: 300" class="w-full bg-white border border-slate-300 rounded-lg p-2 text-xs text-slate-900 outline-none" />
                        </div>

                        <div id="salaryRaiseFields" class="hidden bg-blue-50/80 p-3.5 rounded-xl border border-blue-200 space-y-3">
                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-[11px] text-slate-700 mb-1 font-bold">الراتب الحالي</label>
                                    <input type="number" step="0.01" name="CurrentSalary" id="currentSalaryInput" oninput="updateSalaryCounter()" placeholder="مثال: 950" class="w-full bg-white border border-slate-300 rounded-lg p-2 text-xs text-slate-900 outline-none" />
                                </div>
                                <div>
                                    <label class="block text-[11px] text-slate-700 mb-1 font-bold">مبلغ الزيادة المطلوب</label>
                                    <input type="number" step="0.01" name="RequestedRaiseAmount" id="raiseAmountInput" oninput="updateSalaryCounter()" placeholder="مثال: 150" class="w-full bg-white border border-slate-300 rounded-lg p-2 text-xs text-slate-900 outline-none" />
                                </div>
                            </div>
                            <div class="bg-white p-3 rounded-xl border border-blue-200 flex items-center justify-between text-xs">
                                <div>
                                    <span class="text-slate-500 block text-[10px] font-bold">الراتب الجديد المتوقع</span>
                                    <strong id="counterNewSalary" class="text-base font-black text-blue-700">0.00</strong>
                                </div>
                                <div class="text-center">
                                    <span class="text-slate-500 block text-[10px] font-bold">قيمة الزيادة</span>
                                    <strong id="counterRaiseDiff" class="text-sm font-extrabold text-emerald-600">+0.00</strong>
                                </div>
                                <div class="text-left">
                                    <span class="text-slate-500 block text-[10px] font-bold">نسبة الزيادة</span>
                                    <span id="counterRaisePercent" class="inline-block px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-black text-[11px]">0%</span>
                                </div>
                            </div>
                        </div>

                        <input type="hidden" name="isAnonymous" id="isAnonymousInput" value="false" />

                        <div>
                            <label class="block text-xs text-slate-700 mb-1.5 font-bold">السبب والتفاصيل</label>
                            <textarea name="Details" rows="3" required placeholder="اكتب سبب الطلب أو تفاصيله بوضوح..." class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-xs focus:border-blue-600 focus:bg-white outline-none"></textarea>
                        </div>

                        <div>
                            <label class="block text-xs text-slate-700 mb-1.5 font-bold">إرفاق ملف أو صورة داعمة (اختياري)</label>
                            <input type="file" name="attachmentFile" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2 text-xs text-slate-600 file:ml-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-blue-700 file:text-white hover:file:bg-blue-800" />
                        </div>

                        <button type="submit" class="w-full primary-btn py-3 rounded-xl font-bold text-xs shadow-sm">إرسال الطلب</button>
                    </form>
                </div>

                <div class="lg:col-span-7 panel p-6 rounded-2xl">
                    <h3 class="font-extrabold text-slate-900 text-base mb-4">طلباتي الشخصية ومسار المتابعة (Timeline)</h3>
                    <div class="space-y-4 max-h-[680px] overflow-y-auto pr-1">
                        @if (!Model.Any())
                        {
                            <p class="text-xs text-slate-500 py-8 text-center">لا توجد طلبات مسجلة باسمك حالياً.</p>
                        }
                        @foreach (var req in Model)
                        {
                            bool isPending = req.Status == SmartHR_Platform.Models.RequestStatus.Pending;
                            bool isApproved = req.Status == SmartHR_Platform.Models.RequestStatus.Approved;
                            bool isRejected = req.Status == SmartHR_Platform.Models.RequestStatus.Rejected;
                            bool isCancelled = req.Status == SmartHR_Platform.Models.RequestStatus.Cancelled;

                            <div class="card-item p-5 rounded-2xl">
                                <div class="flex flex-wrap justify-between items-center gap-2 mb-3">
                                    <div class="flex items-center gap-2">
                                        <span class="text-xs font-black text-blue-700">#@req.Id</span>
                                        <span class="px-2.5 py-1 rounded-lg bg-blue-100/80 text-blue-900 text-xs font-extrabold">@GetTypeArabic(req.Type)</span>
                                        <span class="text-[11px] text-slate-400">@req.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                    </div>
                                    <span class="px-3 py-1 rounded-full text-[11px] font-extrabold @(isApproved ? "bg-emerald-100 text-emerald-800" : isRejected ? "bg-rose-100 text-rose-800" : isCancelled ? "bg-slate-200 text-slate-700" : "bg-amber-100 text-amber-800")">
                                        @(isApproved ? "تمت الموافقة ✓" : isRejected ? "مرفوض ✕" : isCancelled ? "ملغى" : "قيد المراجعة ⏳")
                                    </span>
                                </div>

                                <div class="flex flex-wrap gap-2 mb-2 text-[11px]">
                                    @if (req.StartDate.HasValue)
                                    {
                                        <span class="bg-white border border-slate-200 px-2.5 py-1 rounded-lg text-slate-700 font-semibold">
                                            📅 التاريخ: @req.StartDate.Value.ToString("yyyy-MM-dd") @(req.EndDate.HasValue ? $" إلى {req.EndDate.Value.ToString("yyyy-MM-dd")}" : "")
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(req.ExitTime))
                                    {
                                        <span class="bg-white border border-slate-200 px-2.5 py-1 rounded-lg text-slate-700 font-semibold">
                                            ⏰ الوقت: @req.ExitTime
                                        </span>
                                    }
                                    @if (req.AdvanceAmount.HasValue)
                                    {
                                        <span class="bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-lg text-emerald-800 font-bold">
                                            💵 المبلغ: @req.AdvanceAmount.Value.ToString("0.##") دينار
                                        </span>
                                    }
                                    @if (req.RequestedRaiseAmount.HasValue)
                                    {
                                        <span class="bg-blue-50 border border-blue-200 px-2.5 py-1 rounded-lg text-blue-800 font-bold">
                                            📈 زيادة مطلوبة: +@req.RequestedRaiseAmount.Value.ToString("0.##")
                                            @(req.CurrentSalary.HasValue ? $"(الراتب الجديد: {(req.CurrentSalary.Value + req.RequestedRaiseAmount.Value).ToString("0.##")})" : "")
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(req.AttachmentPath))
                                    {
                                        <a href="@req.AttachmentPath" target="_blank" class="bg-indigo-50 border border-indigo-200 px-2.5 py-1 rounded-lg text-indigo-700 font-bold hover:bg-indigo-100">
                                            📎 عرض المرفق (@(req.AttachmentName ?? "ملف"))
                                        </a>
                                    }
                                </div>

                                <p class="text-xs text-slate-700 bg-white p-3 rounded-xl border border-slate-200/80 mb-4">@req.Details</p>

                                <div class="bg-white p-3.5 rounded-xl border border-slate-200 mb-3">
                                    <p class="text-[11px] font-bold text-slate-500 mb-3">مسار الطلب (Timeline):</p>
                                    <div class="grid grid-cols-3 gap-2 text-center text-[11px]">
                                        <div class="flex flex-col items-center">
                                            <div class="w-6 h-6 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold text-[10px] mb-1">✓</div>
                                            <span class="font-bold text-slate-800">1. تم الإرسال</span>
                                            <span class="text-[10px] text-slate-400">@req.CreatedAt.ToString("MM/dd HH:mm")</span>
                                        </div>
                                        <div class="flex flex-col items-center">
                                            <div class="w-6 h-6 rounded-full @(isPending ? "bg-amber-500 text-white animate-pulse" : "bg-emerald-600 text-white") flex items-center justify-center font-bold text-[10px] mb-1">
                                                @(isPending ? "•••" : "✓")
                                            </div>
                                            <span class="font-bold text-slate-800">2. مراجعة المدير</span>
                                            <span class="text-[10px] text-slate-400">@(isPending ? "بانتظار القرار" : "تمت المراجعة")</span>
                                        </div>
                                        <div class="flex flex-col items-center">
                                            <div class="w-6 h-6 rounded-full @(isApproved ? "bg-emerald-600 text-white" : isRejected ? "bg-rose-600 text-white" : isCancelled ? "bg-slate-500 text-white" : "bg-slate-200 text-slate-500") flex items-center justify-center font-bold text-[10px] mb-1">
                                                @(isApproved ? "✓" : isRejected ? "✕" : isCancelled ? "—" : "3")
                                            </div>
                                            <span class="font-bold @(isRejected ? "text-rose-700" : isApproved ? "text-emerald-700" : "text-slate-600")">
                                                @(isApproved ? "معتمد" : isRejected ? "مرفوض" : isCancelled ? "ملغى" : "القرار النهائي")
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(req.ManagerNote))
                                {
                                    <div class="p-3 rounded-xl text-xs mb-3 @(isRejected ? "bg-rose-50 border border-rose-200 text-rose-900" : "bg-blue-50 border border-blue-200 text-blue-900")">
                                        <strong>@(isRejected ? "سبب الرفض وملاحظة الإدارة:" : "ملاحظة الإدارة:")</strong> @req.ManagerNote
                                    </div>
                                }

                                @if (isPending)
                                {
                                    <div class="flex justify-end gap-2 pt-2 border-t border-slate-200/70">
                                        <button type="button"
                                                onclick='openEditModal(@req.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(req.Details)), "@(req.StartDate?.ToString("yyyy-MM-dd") ?? "")", "@(req.EndDate?.ToString("yyyy-MM-dd") ?? "")", @Html.Raw(System.Text.Json.JsonSerializer.Serialize(req.ExitTime ?? "")), "@(req.AdvanceAmount?.ToString() ?? "")", "@(req.CurrentSalary?.ToString() ?? "")", "@(req.RequestedRaiseAmount?.ToString() ?? "")")'
                                                class="px-3.5 py-1.5 rounded-lg bg-white hover:bg-blue-50 border border-slate-300 text-xs font-bold text-blue-700 transition">
                                            تعديل الطلب ✏️
                                        </button>

                                        <form asp-action="CancelRequest" method="post" onsubmit="return confirm('هل أنت متأكد من إلغاء هذا الطلب؟');">
                                            <input type="hidden" name="id" value="@req.Id" />
                                            <button type="submit" class="px-3.5 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 border border-rose-200 text-xs font-bold text-rose-700 transition">
                                                إلغاء الطلب ✕
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- ==================== 2. لوحة المدير المباشر ==================== -->
        @if (currentRole == "Manager")
        {
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-8">
                <div class="lg:col-span-8 panel p-6 rounded-2xl">
                    <div class="flex flex-wrap justify-between items-center gap-3 mb-4">
                        <h3 class="text-base font-extrabold text-slate-900">طلبات الفريق للمراجعة واتخاذ القرار</h3>

                        <input type="text" id="requestSearchInput" onkeyup="applyRequestFilters()" placeholder="🔍 بحث بالاسم أو رقم الطلب (#101)..." class="w-full sm:w-64 bg-slate-50 border border-slate-300 rounded-xl px-3.5 py-2 text-xs text-slate-900 outline-none focus:border-blue-600 focus:bg-white" />
                    </div>

                    <div class="flex flex-wrap items-center justify-between gap-2 pb-4 mb-4 border-b border-slate-100">
                        <div class="flex flex-wrap gap-1.5">
                            <button type="button" onclick="filterRequests('All')" class="filter-btn px-3 py-1.5 rounded-lg bg-blue-700 text-white text-xs font-bold" data-status="All">الكل</button>
                            <button type="button" onclick="filterRequests('Pending')" class="filter-btn px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 text-xs font-bold" data-status="Pending">معلق</button>
                            <button type="button" onclick="filterRequests('Approved')" class="filter-btn px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 text-xs font-bold" data-status="Approved">مقبول</button>
                            <button type="button" onclick="filterRequests('Rejected')" class="filter-btn px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 text-xs font-bold" data-status="Rejected">مرفوض</button>
                        </div>

                        <select id="typeFilterSelect" onchange="applyRequestFilters()" class="bg-slate-50 border border-slate-300 rounded-lg px-3 py-1.5 text-xs font-bold text-slate-700 outline-none focus:border-blue-600">
                            <option value="All">كل الأنواع</option>
                            <option value="AnnualLeave">طلبات الإجازة</option>
                            <option value="SalaryAdvance">طلبات السلف</option>
                            <option value="ExitPermission">أذونات الخروج</option>
                            <option value="SalaryRaise">طلبات زيادة الراتب</option>
                            <option value="BranchTransfer">نقل فرع</option>
                            <option value="Resignation">الاستقالات</option>
                        </select>
                    </div>

                    <div class="bg-blue-50/70 border border-blue-200 p-3.5 rounded-xl mb-5 flex flex-wrap items-center justify-between gap-3">
                        <label class="flex items-center gap-2 text-xs font-bold text-slate-800 cursor-pointer">
                            <input type="checkbox" id="selectAllPending" onchange="toggleSelectAllPending(this)" class="w-4 h-4 rounded accent-blue-700" />
                            <span>تحديد المعلّق (<span id="selectedBulkCount">0</span> محدد)</span>
                        </label>
                        <div class="flex flex-wrap items-center gap-2">
                            <input type="text" id="bulkApprovalNote" placeholder="ملاحظة للموافقة الجماعية (اختياري)..." class="bg-white border border-slate-300 rounded-lg px-3 py-1.5 text-xs text-slate-900 outline-none" />
                            <button type="button" onclick="executeBulkApprove()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-4 py-1.5 rounded-lg text-xs transition">
                                موافقة جماعية ✓
                            </button>
                        </div>
                    </div>

                    <div id="requestsListContainer" class="space-y-4">
                        @foreach (var req in Model)
                        {
                            bool isPending = req.Status == SmartHR_Platform.Models.RequestStatus.Pending;
                            bool hasConflict = HasLeaveConflict(req);

                            var empHistory = allHistoryRequests.Where(x => x.EmployeeName == req.EmployeeName).ToList();
                            int usedLeaveDays = empHistory
                            .Where(x => x.Type == SmartHR_Platform.Models.RequestType.AnnualLeave && x.Status == SmartHR_Platform.Models.RequestStatus.Approved && x.StartDate.HasValue)
                            .Sum(x => Math.Max(1, ((x.EndDate ?? x.StartDate)!.Value.Date - x.StartDate!.Value.Date).Days + 1));
                            int remainingLeaveBalance = Math.Max(0, 21 - usedLeaveDays);
                            int empApprovedCount = empHistory.Count(x => x.Status == SmartHR_Platform.Models.RequestStatus.Approved);
                            int empRejectedCount = empHistory.Count(x => x.Status == SmartHR_Platform.Models.RequestStatus.Rejected);

                            <div id="req-card-@req.Id"
                                 class="request-item card-item p-5 rounded-2xl border-r-4 @(isPending ? "border-r-amber-500" : "border-r-blue-600")"
                                 data-status="@req.Status"
                                 data-type="@req.Type"
                                 data-search="@req.Id @req.EmployeeName @req.Department @GetTypeArabic(req.Type) @req.Details">

                                @if (hasConflict)
                                {
                                    <div class="mb-3 bg-amber-50 border border-amber-300 text-amber-900 px-3.5 py-2 rounded-xl text-xs font-bold flex items-center gap-2">
                                        <span>⚠️ تحذير تعارض إجازات:</span>
                                        <span>توجد فترة إجازة متداخلة مع زميل آخر في نفس التاريخ المحدد.</span>
                                    </div>
                                }

                                <div class="flex flex-wrap justify-between items-start gap-4">
                                    <div class="flex-1 min-w-[260px]">
                                        <div class="flex flex-wrap items-center gap-2 mb-2">
                                            @if (isPending)
                                            {
                                                <input type="checkbox" value="@req.Id" onchange="updateBulkCount()" class="bulk-checkbox w-4 h-4 rounded accent-blue-700 cursor-pointer" />
                                            }
                                            <span class="text-xs font-black text-blue-700">#@req.Id</span>
                                            <h4 class="text-sm font-extrabold text-slate-900">@req.EmployeeName</h4>
                                            <span class="text-xs text-slate-500">(@req.Department — @GetTypeArabic(req.Type))</span>
                                            <span id="req-status-badge-@req.Id" class="px-2.5 py-0.5 rounded-full text-[11px] font-bold @(req.Status == SmartHR_Platform.Models.RequestStatus.Approved ? "bg-emerald-100 text-emerald-800" : req.Status == SmartHR_Platform.Models.RequestStatus.Rejected ? "bg-rose-100 text-rose-800" : "bg-amber-100 text-amber-800")">
                                                @req.Status
                                            </span>
                                            @if (!string.IsNullOrEmpty(req.AttachmentPath))
                                            {
                                                <a href="@req.AttachmentPath" target="_blank" class="text-[11px] bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded font-bold">📎 مرفق</a>
                                            }
                                        </div>

                                        <div class="flex flex-wrap gap-2 mb-2.5 text-[11px]">
                                            <span class="bg-white border border-slate-200 px-2.5 py-1 rounded-lg text-slate-700 font-bold">
                                                🏖️ رصيد الإجازة المتبقي: <strong class="text-blue-700">@remainingLeaveBalance يوم</strong> (من 21)
                                            </span>
                                            <span class="bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-lg text-emerald-800 font-semibold">
                                                طلبات سابقة مقبولة: <strong>@empApprovedCount</strong>
                                            </span>
                                            <span class="bg-rose-50 border border-rose-200 px-2.5 py-1 rounded-lg text-rose-800 font-semibold">
                                                مرفوضة: <strong>@empRejectedCount</strong>
                                            </span>
                                            @if (req.StartDate.HasValue)
                                            {
                                                <span class="bg-blue-50 border border-blue-200 px-2.5 py-1 rounded-lg text-blue-900 font-semibold">
                                                    📅 @req.StartDate.Value.ToString("yyyy-MM-dd") @(req.EndDate.HasValue ? $"← {req.EndDate.Value.ToString("yyyy-MM-dd")}" : "")
                                                </span>
                                            }
                                            @if (req.AdvanceAmount.HasValue)
                                            {
                                                <span class="bg-amber-50 border border-amber-200 px-2.5 py-1 rounded-lg text-amber-900 font-bold">
                                                    💵 سلفة: @req.AdvanceAmount.Value.ToString("0.##")
                                                </span>
                                            }
                                            @if (req.RequestedRaiseAmount.HasValue)
                                            {
                                                <span class="bg-indigo-50 border border-indigo-200 px-2.5 py-1 rounded-lg text-indigo-900 font-bold">
                                                    📈 زيادة: +@req.RequestedRaiseAmount.Value.ToString("0.##")
                                                </span>
                                            }
                                        </div>

                                        <p class="text-xs text-slate-700 bg-white p-3.5 rounded-xl border border-slate-200">@req.Details</p>
                                    </div>

                                    <div id="req-action-box-@req.Id" class="w-full md:w-80 bg-white p-4 rounded-xl border border-slate-200">
                                        @if (isPending)
                                        {
                                            <div class="space-y-2.5">
                                                <label class="block text-[11px] font-bold text-slate-700">ملاحظة القرار <span class="text-rose-600">(إجبارية عند الرفض)</span></label>
                                                <input type="text" id="note-input-@req.Id" placeholder="اكتب سبب الرفض أو ملاحظة القبول..." class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 text-xs text-slate-900 outline-none focus:border-blue-600" />
                                                <p id="note-error-@req.Id" class="hidden text-[11px] text-rose-600 font-bold">⚠️ يرجى إدخال سبب الرفض قبل تنفيذ القرار.</p>
                                                <div class="grid grid-cols-2 gap-2 pt-1">
                                                    <button type="button" onclick="submitManagerDecision(@req.Id, true)" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 rounded-lg text-xs transition">قبول</button>
                                                    <button type="button" onclick="submitManagerDecision(@req.Id, false)" class="bg-rose-600 hover:bg-rose-700 text-white font-bold py-2 rounded-lg text-xs transition">رفض</button>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-xs space-y-1">
                                                <p class="font-bold @(req.Status == SmartHR_Platform.Models.RequestStatus.Approved ? "text-emerald-700" : "text-rose-700")">الحالة: @req.Status</p>
                                                <p class="text-slate-600">@req.ManagerNote</p>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="lg:col-span-4 panel p-6 rounded-2xl h-fit">
                    <div class="flex justify-between items-center mb-4 pb-3 border-b border-slate-100">
                        <h3 class="text-sm font-extrabold text-slate-900">سجل القرارات الأخيرة</h3>
                        <span class="text-[11px] bg-blue-50 text-blue-700 px-2.5 py-0.5 rounded-full font-bold">مباشر</span>
                    </div>
                    <div id="recentDecisionsList" class="space-y-3 max-h-[560px] overflow-y-auto">
                        @if (!recentDecisions.Any())
                        {
                            <p class="text-xs text-slate-400 text-center py-6">لا توجد قرارات مسجلة بعد.</p>
                        }
                        @foreach (var dec in recentDecisions)
                        {
                            bool isRej = dec.Decision.Contains("مرفوض");
                            <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 text-xs space-y-1">
                                <div class="flex justify-between items-center">
                                    <span class="font-extrabold text-slate-900">#@dec.RequestId — @dec.EmployeeName</span>
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold @(isRej ? "bg-rose-100 text-rose-800" : "bg-emerald-100 text-emerald-800")">@dec.Decision</span>
                                </div>
                                <p class="text-slate-600 text-[11px]">@dec.Note</p>
                                <p class="text-[10px] text-slate-400 text-left">@dec.TimeText</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- ==================== 3. الموارد البشرية ==================== -->
        @if (currentRole == "HR")
        {
            <div class="space-y-6 mb-8">
                <div class="panel p-6 rounded-2xl flex flex-wrap justify-between items-center gap-4">
                    <div>
                        <h3 class="font-extrabold text-slate-900 text-base">التقرير التنفيذي للموارد البشرية</h3>
                        <p class="text-xs text-slate-500 mt-1">متاح فقط لقسم الموارد البشرية.</p>
                    </div>
                    <a href="/Dashboard/ExportExecutiveReport" class="bg-emerald-600 hover:bg-emerald-700 px-5 py-3 rounded-xl text-xs font-bold text-white transition">
                        تنزيل التقرير التنفيذي 📥
                    </a>
                </div>

                <div class="panel p-6 rounded-2xl">
                    <h3 class="font-extrabold text-slate-900 text-base mb-4">صندوق البلاغات السرية (مجهولة المصدر 🔒)</h3>
                    <div class="space-y-3">
                        @if (!Model.Any(r => r.IsAnonymous))
                        {
                            <p class="text-xs text-slate-400">لا توجد بلاغات سرية مسجلة حالياً.</p>
                        }
                        @foreach (var whistle in Model.Where(r => r.IsAnonymous))
                        {
                            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                                <div class="flex justify-between items-center mb-2">
                                    <span class="px-2.5 py-0.5 rounded bg-indigo-100 text-indigo-800 text-[11px] font-bold">بلاغ سري — @whistle.Department</span>
                                    <span class="text-[11px] text-slate-500">@whistle.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                </div>
                                <p class="text-xs text-slate-800 leading-relaxed">@whistle.Details</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- ==================== 4. مدير النظام ==================== -->
        @if (currentRole == "Admin" && canViewAuditTrail)
        {
            <div id="auditSection" class="panel p-6 rounded-2xl mb-8">
                <div class="flex flex-wrap justify-between items-center gap-3 mb-4">
                    <div>
                        <h3 class="text-base font-extrabold text-slate-900">سجل التدقيق الأمني (Audit Trail)</h3>
                        <p class="text-xs text-slate-500">مخصص لمدير النظام فقط لتتبع الحركات والصلاحيات.</p>
                    </div>
                    <input type="text" id="auditSearchInput" onkeyup="filterAuditLogs()" placeholder="بحث في السجل..." class="bg-slate-50 border border-slate-300 rounded-lg px-3 py-1.5 text-xs text-slate-900 outline-none focus:border-blue-600" />
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-right border-collapse text-xs">
                        <thead>
                            <tr class="border-b border-slate-200 text-slate-500">
                                <th class="py-3 px-4 font-bold">المعرف</th>
                                <th class="py-3 px-4 font-bold">الإجراء</th>
                                <th class="py-3 px-4 font-bold">الجهة المنفذة</th>
                                <th class="py-3 px-4 font-bold">التفاصيل</th>
                                <th class="py-3 px-4 font-bold">الوقت</th>
                            </tr>
                        </thead>
                        <tbody id="auditTableBody" class="divide-y divide-slate-100">
                            @foreach (var log in auditLogs)
                            {
                                <tr class="audit-row hover:bg-slate-50" data-search="@log.Action @log.PerformedBy @log.Details">
                                    <td class="py-3 px-4 font-extrabold text-blue-700">#@log.Id</td>
                                    <td class="py-3 px-4 text-slate-900 font-bold">@log.Action</td>
                                    <td class="py-3 px-4 text-slate-700">@log.PerformedBy</td>
                                    <td class="py-3 px-4 text-slate-600">@log.Details</td>
                                    <td class="py-3 px-4 text-slate-400">@log.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </main>

    <!-- نافذة تعديل الطلب المعلق للموظف -->
    <div id="editModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 flex items-center justify-center p-4">
        <div class="bg-white border border-slate-200 rounded-2xl max-w-md w-full p-6 shadow-2xl">
            <div class="flex justify-between items-center pb-3 mb-4 border-b border-slate-100">
                <h4 class="font-extrabold text-base text-slate-900">تعديل الطلب المعلق</h4>
                <button type="button" onclick="closeEditModal()" class="text-slate-400 hover:text-slate-700 text-lg font-bold">✕</button>
            </div>
            <form asp-action="EditRequest" method="post" class="space-y-3 text-xs">
                <input type="hidden" name="id" id="editReqId" />
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-slate-600 mb-1 font-bold">من تاريخ</label>
                        <input type="date" name="startDate" id="editStartDate" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2" />
                    </div>
                    <div>
                        <label class="block text-slate-600 mb-1 font-bold">إلى تاريخ</label>
                        <input type="date" name="endDate" id="editEndDate" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2" />
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-slate-600 mb-1 font-bold">وقت الخروج (إن وجد)</label>
                        <input type="text" name="exitTime" id="editExitTime" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2" />
                    </div>
                    <div>
                        <label class="block text-slate-600 mb-1 font-bold">مبلغ السلفة (إن وجد)</label>
                        <input type="number" step="0.01" name="advanceAmount" id="editAdvanceAmount" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2" />
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-slate-600 mb-1 font-bold">الراتب الحالي</label>
                        <input type="number" step="0.01" name="currentSalary" id="editCurrentSalary" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2" />
                    </div>
                    <div>
                        <label class="block text-slate-600 mb-1 font-bold">مبلغ الزيادة</label>
                        <input type="number" step="0.01" name="requestedRaiseAmount" id="editRaiseAmount" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2" />
                    </div>
                </div>
                <div>
                    <label class="block text-slate-600 mb-1 font-bold">السبب والتفاصيل</label>
                    <textarea name="details" id="editDetails" rows="3" required class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5"></textarea>
                </div>
                <div class="flex justify-end gap-2 pt-2">
                    <button type="button" onclick="closeEditModal()" class="px-4 py-2 rounded-xl bg-slate-100 text-slate-700 font-bold">إلغاء</button>
                    <button type="submit" class="primary-btn px-5 py-2 rounded-xl font-bold">حفظ التعديلات</button>
                </div>
            </form>
        </div>
    </div>

    <!-- نافذة المعاينة السريعة -->
    <div id="inspectModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 flex items-center justify-center p-4">
        <div class="bg-white border border-slate-200 rounded-2xl max-w-lg w-full p-6 shadow-2xl">
            <div class="flex justify-between items-center pb-3 mb-4 border-b border-slate-100">
                <h4 id="modalTitle" class="font-extrabold text-base text-slate-900">تفاصيل الطلب</h4>
                <button type="button" onclick="closeInspectModal()" class="text-slate-400 hover:text-slate-700 text-lg font-bold">✕</button>
            </div>
            <div class="space-y-3 text-xs">
                <div class="grid grid-cols-2 gap-3 bg-slate-50 p-3.5 rounded-xl border border-slate-200">
                    <div><span class="text-slate-400 block">مقدم الطلب:</span><strong id="modalEmp" class="text-slate-900"></strong></div>
                    <div><span class="text-slate-400 block">القسم:</span><strong id="modalDept" class="text-slate-800"></strong></div>
                    <div><span class="text-slate-400 block">نوع الطلب:</span><strong id="modalType" class="text-blue-700"></strong></div>
                    <div><span class="text-slate-400 block">الحالة:</span><strong id="modalStatus" class="text-amber-700"></strong></div>
                </div>
                <div>
                    <span class="text-slate-600 block mb-1 font-bold">التفاصيل:</span>
                    <p id="modalDetails" class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 text-slate-800 leading-relaxed"></p>
                </div>
                <div>
                    <span class="text-slate-600 block mb-1 font-bold">ملاحظة الإدارة:</span>
                    <p id="modalNote" class="bg-slate-50 p-3 rounded-xl border border-slate-200 text-slate-700"></p>
                </div>
                <p id="modalDate" class="text-[11px] text-slate-400 text-left"></p>
            </div>
            <div class="mt-5 flex justify-end">
                <button type="button" onclick="closeInspectModal()" class="primary-btn px-5 py-2 rounded-xl text-xs font-bold">إغلاق</button>
            </div>
        </div>
    </div>

    <!-- الشريط الجانبي الثابت للأدوات الخمس -->
    <div class="fixed left-0 top-1/2 -translate-y-1/2 z-40 bg-white border border-slate-200 border-l-0 rounded-r-2xl shadow-lg p-1.5 flex flex-col gap-1.5">
        <button type="button" onclick="openUtilityTab('helpdesk')" title="الدعم الفني" class="w-10 h-10 rounded-xl hover:bg-blue-50 text-slate-700 hover:text-blue-700 flex flex-col items-center justify-center text-[10px] font-bold transition">
            <span class="text-sm leading-none">🎧</span>
            <span class="mt-0.5">الدعم</span>
        </button>
        <button type="button" onclick="openUtilityTab('assistant')" title="المساعد الذكي" class="w-10 h-10 rounded-xl hover:bg-blue-50 text-slate-700 hover:text-blue-700 flex flex-col items-center justify-center text-[10px] font-bold transition">
            <span class="text-sm leading-none">🤖</span>
            <span class="mt-0.5">مساعد</span>
        </button>
        <button type="button" onclick="openUtilityTab('alerts')" title="مركز التنبيهات" class="relative w-10 h-10 rounded-xl hover:bg-blue-50 text-slate-700 hover:text-blue-700 flex flex-col items-center justify-center text-[10px] font-bold transition">
            <span class="text-sm leading-none">🔔</span>
            <span class="mt-0.5">تنبيه</span>
            <span id="utilUnreadDot" class="w-2 h-2 rounded-full bg-rose-600 absolute top-1.5 right-2"></span>
        </button>
        <button type="button" onclick="openUtilityTab('notes')" title="دفتر الملاحظات" class="w-10 h-10 rounded-xl hover:bg-blue-50 text-slate-700 hover:text-blue-700 flex flex-col items-center justify-center text-[10px] font-bold transition">
            <span class="text-sm leading-none">📝</span>
            <span class="mt-0.5">ملاحظة</span>
        </button>
        <button type="button" onclick="openUtilityTab('guide')" title="دليل الصلاحيات" class="w-10 h-10 rounded-xl hover:bg-blue-50 text-slate-700 hover:text-blue-700 flex flex-col items-center justify-center text-[10px] font-bold transition">
            <span class="text-sm leading-none">🛡️</span>
            <span class="mt-0.5">أدوار</span>
        </button>
    </div>

    <!-- لوحة الأدوات الجانبية المنزلقة -->
    <aside id="utilityDrawer" class="hidden fixed top-0 left-0 h-full w-full sm:w-[430px] bg-white border-r border-slate-200 shadow-2xl z-50 flex flex-col">
        <div class="p-4 border-b border-slate-200 flex items-center justify-between bg-slate-50">
            <div class="flex items-center gap-2">
                <span class="w-8 h-8 rounded-lg bg-blue-700 text-white flex items-center justify-center text-xs font-black">⚡</span>
                <div>
                    <h4 class="text-xs font-black text-slate-900">صندوق الأدوات الجانبية</h4>
                    <p class="text-[10px] text-slate-500">الدور الحالي: <strong class="text-blue-700">@currentRole</strong></p>
                </div>
            </div>
            <button type="button" onclick="closeUtilityDrawer()" class="w-8 h-8 rounded-lg hover:bg-slate-200 text-slate-600 font-bold text-sm">✕</button>
        </div>

        <div class="grid grid-cols-5 gap-1 p-2 border-b border-slate-100 bg-white text-[10px] font-bold">
            <button type="button" onclick="switchUtilityTab('helpdesk')" id="utab-btn-helpdesk" class="utab-btn py-2 rounded-lg bg-blue-700 text-white">الدعم الفني</button>
            <button type="button" onclick="switchUtilityTab('assistant')" id="utab-btn-assistant" class="utab-btn py-2 rounded-lg bg-slate-100 text-slate-700">المساعد</button>
            <button type="button" onclick="switchUtilityTab('alerts')" id="utab-btn-alerts" class="utab-btn py-2 rounded-lg bg-slate-100 text-slate-700">التنبيهات</button>
            <button type="button" onclick="switchUtilityTab('notes')" id="utab-btn-notes" class="utab-btn py-2 rounded-lg bg-slate-100 text-slate-700">ملاحظاتي</button>
            <button type="button" onclick="switchUtilityTab('guide')" id="utab-btn-guide" class="utab-btn py-2 rounded-lg bg-slate-100 text-slate-700">الصلاحيات</button>
        </div>

        <div class="flex-1 overflow-y-auto p-4 space-y-4 text-xs">

            <!-- 1. الدعم الفني -->
            <div id="utab-helpdesk" class="utab-panel space-y-4">
                <div class="bg-slate-50 border border-slate-200 rounded-xl p-3.5 space-y-2.5">
                    <div class="flex items-center justify-between">
                        <h5 class="font-extrabold text-slate-900">فتح تذكرة دعم فني جديدة</h5>
                        <span class="text-[10px] bg-blue-100 text-blue-800 px-2 py-0.5 rounded-full font-bold">Helpdesk</span>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-[10px] font-bold text-slate-600 mb-1">نوع المشكلة</label>
                            <select id="ticketCategory" class="w-full bg-white border border-slate-300 rounded-lg p-2 text-xs outline-none">
                                <option value="صلاحيات">صلاحيات</option>
                                <option value="نظام الموارد البشرية">نظام الموارد البشرية</option>
                                <option value="بوابة الموظف">بوابة الموظف</option>
                                <option value="عطل فني">عطل فني</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-slate-600 mb-1">الأولوية</label>
                            <select id="ticketPriority" class="w-full bg-white border border-slate-300 rounded-lg p-2 text-xs outline-none">
                                <option value="منخفضة">منخفضة</option>
                                <option value="متوسطة" selected>متوسطة</option>
                                <option value="عالية">عالية</option>
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-slate-600 mb-1">وصف المشكلة</label>
                        <textarea id="ticketDescription" rows="2" placeholder="اشرح المشكلة أو رمز الخطأ..." class="w-full bg-white border border-slate-300 rounded-lg p-2 text-xs outline-none"></textarea>
                    </div>
                    <button type="button" onclick="createHelpdeskTicket()" class="w-full primary-btn py-2 rounded-xl font-bold text-xs">إرسال التذكرة</button>
                </div>

                <div>
                    <h5 class="font-extrabold text-slate-900 mb-2">تذاكري الحالية</h5>
                    <div id="ticketsListContainer" class="space-y-2">
                        @foreach (var t in supportTickets)
                        {
                            <div class="bg-white border border-slate-200 rounded-xl p-3 space-y-1">
                                <div class="flex items-center justify-between">
                                    <span class="font-extrabold text-blue-700">@t.TicketNo — @t.Category</span>
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold @(t.Status == "مغلقة" ? "bg-slate-200 text-slate-700" : t.Status == "مفتوحة" ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">@t.Status</span>
                                </div>
                                <p class="text-slate-700 text-[11px]">@t.Summary</p>
                                <div class="flex justify-between text-[10px] text-slate-400">
                                    <span>الأولوية: @t.Priority</span>
                                    <span>@t.CreatedAtText</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="bg-blue-50/70 border border-blue-100 rounded-xl p-3 space-y-2">
                    <h5 class="font-extrabold text-slate-900">أسئلة شائعة سريعة (FAQ)</h5>
                    <details class="bg-white p-2.5 rounded-lg border border-slate-200">
                        <summary class="font-bold text-slate-800 cursor-pointer text-[11px]">كيف أقدم طلب إجازة أو سلفة أو زيادة راتب؟</summary>
                        <p class="text-[11px] text-slate-600 mt-1.5">من بوابة الموظف اختر نوع الطلب من القائمة المنسدلة، عبّئ الحقول المخصصة، ثم اضغط إرسال الطلب لمتابعته عبر الـ Timeline.</p>
                    </details>
                    <details class="bg-white p-2.5 rounded-lg border border-slate-200">
                        <summary class="font-bold text-slate-800 cursor-pointer text-[11px]">متى يمكنني تعديل أو إلغاء الطلب؟</summary>
                        <p class="text-[11px] text-slate-600 mt-1.5">تظهر أزرار التعديل والإلغاء طالما أن حالة الطلب ما زالت (قيد المراجعة) ولم يتخذ المدير قراراً نهائياً.</p>
                    </details>
                </div>
            </div>

            <!-- 2. المساعد الذكي للمنصة -->
            <div id="utab-assistant" class="utab-panel hidden space-y-3">
                <div class="bg-blue-50 border border-blue-200 rounded-xl p-3">
                    <p class="font-extrabold text-blue-900 text-xs">مساعد SmartHR السياقي</p>
                    <p class="text-[11px] text-blue-800 mt-0.5">سياق الصفحة الحالية: <strong>@currentRole</strong></p>
                </div>

                <div class="flex flex-wrap gap-1.5">
                    <button type="button" onclick="askSmartAssistant('لخّص لي آخر التغييرات الأمنية')" class="px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-blue-50 border border-slate-200 text-[11px] font-bold text-slate-700">لخّص لي آخر التغييرات الأمنية</button>
                    <button type="button" onclick="askSmartAssistant('كيف أراجع طلبات الفريق؟')" class="px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-blue-50 border border-slate-200 text-[11px] font-bold text-slate-700">كيف أراجع طلبات الفريق؟</button>
                    <button type="button" onclick="askSmartAssistant('ما حدود صلاحياتي الحالية؟')" class="px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-blue-50 border border-slate-200 text-[11px] font-bold text-slate-700">ما حدود صلاحياتي الحالية؟</button>
                </div>

                <div id="assistantChatBox" class="bg-slate-50 border border-slate-200 rounded-xl p-3 space-y-2.5 min-h-[180px] max-h-[260px] overflow-y-auto">
                    <div class="bg-white border border-slate-200 rounded-xl p-3 text-[11px] text-slate-700 leading-relaxed">
                        مرحباً بك! أنا مساعدك الذكي داخل المنصة. اختر سؤالاً جاهزاً بالأعلى أو اكتب استفسارك بالأسفل وسأساعدك حسب دورك الحالي (<strong>@currentRole</strong>).
                    </div>
                </div>

                <div class="flex gap-1.5">
                    <input type="text" id="assistantInput" onkeydown="if(event.key==='Enter') askSmartAssistant()" placeholder="اكتب سؤالك هنا..." class="flex-1 bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs outline-none focus:border-blue-600 focus:bg-white" />
                    <button type="button" onclick="askSmartAssistant()" class="primary-btn px-3.5 py-2 rounded-xl text-xs font-bold">إرسال</button>
                </div>

                <div class="flex gap-2">
                    <button type="button" onclick="copyLastAssistantReply()" class="flex-1 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-[11px] font-bold">نسخ آخر رد 📋</button>
                    <button type="button" onclick="escalateAssistantToTicket()" class="flex-1 py-2 rounded-xl bg-amber-50 hover:bg-amber-100 border border-amber-200 text-amber-900 text-[11px] font-bold">تحويل إلى تذكرة 🎫</button>
                </div>
