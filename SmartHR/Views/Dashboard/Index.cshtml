                        <button type="button" onclick="filterCenterAlerts('unread')" class="calert-tab px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 text-[11px] font-bold" data-filter="unread">غير مقروء</button>
                        <button type="button" onclick="filterCenterAlerts('security')" class="calert-tab px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 text-[11px] font-bold" data-filter="security">تنبيهات أمنية</button>
                    </div>
                    <div class="flex gap-1.5 text-[11px]">
                        <button type="button" onclick="markAllCenterAlertsRead()" class="text-blue-700 font-bold hover:underline">تحديد الكل كمقروء</button>
                        <span class="text-slate-300">|</span>
                        <button type="button" onclick="clearOldCenterAlerts()" class="text-rose-600 font-bold hover:underline">مسح القديمة</button>
                    </div>
                </div>

                <div id="centerAlertsList" class="space-y-2">
                    <div class="calert-item bg-blue-50/60 border border-blue-200 rounded-xl p-3 space-y-1" data-unread="true" data-security="true">
                        <div class="flex justify-between items-center">
                            <span class="px-2 py-0.5 rounded bg-rose-100 text-rose-800 text-[10px] font-bold">تنبيه أمني</span>
                            <span class="text-[10px] text-slate-400">منذ 10 دقائق</span>
                        </div>
                        <p class="font-bold text-slate-900 text-[11px]">التحقق من عزل البلاغات السرية وفصل الصلاحيات</p>
                        <a href="/Dashboard/Index?role=Admin" class="inline-block text-[11px] text-blue-700 font-bold hover:underline">الانتقال إلى سجل التدقيق ←</a>
                    </div>

                    <div class="calert-item bg-blue-50/60 border border-blue-200 rounded-xl p-3 space-y-1" data-unread="true" data-security="false">
                        <div class="flex justify-between items-center">
                            <span class="px-2 py-0.5 rounded bg-amber-100 text-amber-800 text-[10px] font-bold">طلبات معلقة</span>
                            <span class="text-[10px] text-slate-400">منذ 35 دقيقة</span>
                        </div>
                        <p class="font-bold text-slate-900 text-[11px]">يوجد طلبات بانتظار المراجعة أو الموافقة الجماعية</p>
                        <a href="/Dashboard/Index?role=Manager" class="inline-block text-[11px] text-blue-700 font-bold hover:underline">فتح لوحة المدير المباشر ←</a>
                    </div>

                    <div class="calert-item bg-slate-50 border border-slate-200 rounded-xl p-3 space-y-1" data-unread="false" data-security="false" data-old="true">
                        <div class="flex justify-between items-center">
                            <span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-[10px] font-bold">تقرير HR</span>
                            <span class="text-[10px] text-slate-400">منذ يومين</span>
                        </div>
                        <p class="text-slate-700 text-[11px]">جاهزية التقرير التنفيذي الشهري لاستقرار الكفاءات</p>
                        <a href="/Dashboard/Index?role=HR" class="inline-block text-[11px] text-blue-700 font-bold hover:underline">الانتقال إلى الموارد البشرية ←</a>
                    </div>
                </div>
            </div>

            <!-- 4. دفتر الملاحظات السريعة -->
            <div id="utab-notes" class="utab-panel hidden space-y-3">
                <div class="bg-slate-50 border border-slate-200 rounded-xl p-3 space-y-2">
                    <div class="flex justify-between items-center">
                        <label class="font-extrabold text-slate-900 text-xs">ملاحظة سريعة شخصية</label>
                        <span id="noteAutoSaveStatus" class="text-[10px] text-emerald-700 font-bold">حفظ تلقائي ✓</span>
                    </div>
                    <textarea id="quickNoteInput" rows="3" oninput="autoSaveDraftNote()" placeholder="اكتب ملاحظتك أثناء المراجعة أو التدقيق..." class="w-full bg-white border border-slate-300 rounded-lg p-2 text-xs outline-none focus:border-blue-600"></textarea>
                    <button type="button" onclick="addSavedQuickNote()" class="w-full primary-btn py-2 rounded-xl font-bold text-xs">إضافة إلى دفتر الملاحظات</button>
                </div>

                <div id="savedNotesList" class="space-y-2"></div>
            </div>

            <!-- 5. دليل البوابات والصلاحيات السريع -->
            <div id="utab-guide" class="utab-panel hidden space-y-2.5">
                <div class="bg-amber-50 border border-amber-200 rounded-xl p-2.5 text-[11px] text-amber-900 font-semibold">
                    ⚠️ تنبيه: الانتقال بين البوابات يغيّر مستوى الصلاحيات والبيانات المعروضة حسب الدور.
                </div>

                <div class="bg-white border border-slate-200 rounded-xl p-3 space-y-1">
                    <div class="flex justify-between items-center">
                        <span class="font-extrabold text-slate-900">01. بوابة الموظف (Employee)</span>
                        <a href="/Dashboard/Index?role=Employee" onclick="return confirmRoleSwitch('Employee')" class="text-blue-700 font-bold hover:underline">دخول ←</a>
                    </div>
                    <p class="text-[11px] text-slate-600">تقديم الإجازات، السلف، أذونات الخروج، وزيادة الراتب، ومتابعة طلباته والـ Timeline وتقييمه الشخصي فقط.</p>
                </div>

                <div class="bg-white border border-slate-200 rounded-xl p-3 space-y-1">
                    <div class="flex justify-between items-center">
                        <span class="font-extrabold text-slate-900">02. لوحة المدير المباشر (Manager)</span>
                        <a href="/Dashboard/Index?role=Manager" onclick="return confirmRoleSwitch('Manager')" class="text-blue-700 font-bold hover:underline">دخول ←</a>
                    </div>
                    <p class="text-[11px] text-slate-600">مراجعة طلبات الفريق، الموافقة الفردية أو الجماعية، تنبيه تعارض الإجازات، وسجل القرارات (دون رؤية البلاغات السرية).</p>
                </div>

                <div class="bg-white border border-slate-200 rounded-xl p-3 space-y-1">
                    <div class="flex justify-between items-center">
                        <span class="font-extrabold text-slate-900">03. الموارد البشرية (HR)</span>
                        <a href="/Dashboard/Index?role=HR" onclick="return confirmRoleSwitch('HR')" class="text-blue-700 font-bold hover:underline">دخول ←</a>
                    </div>
                    <p class="text-[11px] text-slate-600">الاطلاع على مؤشرات الأقسام، تصدير التقرير التنفيذي، وإدارة صندوق البلاغات السرية المجهولة.</p>
                </div>

                <div class="bg-white border border-slate-200 rounded-xl p-3 space-y-1">
                    <div class="flex justify-between items-center">
                        <span class="font-extrabold text-slate-900">04. سجل التدقيق الأمني (Admin)</span>
                        <a href="/Dashboard/Index?role=Admin" onclick="return confirmRoleSwitch('Admin')" class="text-blue-700 font-bold hover:underline">دخول ←</a>
                    </div>
                    <p class="text-[11px] text-slate-600">مراقبة سجل حركات النظام والصلاحيات (`Audit Trail`) وتدقيق العمليات.</p>
                </div>
            </div>

        </div>
    </aside>

    <script>
        let currentStatusFilter = 'All';

        function showLiveToast(message, isError = false) {
            const toast = document.getElementById('liveToast');
            const icon = document.getElementById('liveToastIcon');
            const text = document.getElementById('liveToastText');
            if (!toast) return;

            text.innerText = message;
            icon.innerText = isError ? '!' : '✓';
            icon.className = 'w-6 h-6 rounded-full text-white flex items-center justify-center font-black ' + (isError ? 'bg-rose-600' : 'bg-emerald-500');
            toast.classList.remove('hidden');

            clearTimeout(window.__toastTimer);
            window.__toastTimer = setTimeout(() => {
                toast.classList.add('hidden');
            }, 3500);
        }

        function syncCounters(pending, approved, rejected) {
            document.querySelectorAll('.pending-counter-val').forEach(el => {
                el.innerText = pending;
            });
            const bellBadge = document.getElementById('bellBadge');
            if (bellBadge) {
                if (pending > 0) bellBadge.classList.remove('hidden');
                else bellBadge.classList.add('hidden');
            }
            const statApproved = document.getElementById('statApproved');
            if (statApproved) statApproved.innerText = approved;

            const statRejected = document.getElementById('statRejected');
            if (statRejected) statRejected.innerText = rejected;

            const statRejectedCard = document.getElementById('statRejectedCard');
            if (statRejectedCard) statRejectedCard.innerText = rejected;
        }

        function prependRecentDecision(reqId, empName, decisionLabel, note, timeText) {
            const list = document.getElementById('recentDecisionsList');
            if (!list) return;

            const isRej = decisionLabel.includes('مرفوض');
            const badgeClass = isRej ? 'bg-rose-100 text-rose-800' : 'bg-emerald-100 text-emerald-800';

            const html = `
                <div class="bg-slate-50 p-3.5 rounded-xl border border-blue-200 text-xs space-y-1">
                    <div class="flex justify-between items-center">
                        <span class="font-extrabold text-slate-900">#${reqId} — ${empName}</span>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${badgeClass}">${decisionLabel}</span>
                    </div>
                    <p class="text-slate-600 text-[11px]">${note}</p>
                    <p class="text-[10px] text-slate-400 text-left">${timeText}</p>
                </div>`;
            list.insertAdjacentHTML('afterbegin', html);
        }

        async function submitManagerDecision(id, isApproved) {
            const noteInput = document.getElementById('note-input-' + id);
            const errorEl = document.getElementById('note-error-' + id);
            const noteVal = noteInput ? noteInput.value.trim() : '';

            if (!isApproved && !noteVal) {
                if (errorEl) errorEl.classList.remove('hidden');
                if (noteInput) {
                    noteInput.classList.add('border-rose-500');
                    noteInput.focus();
                }
                showLiveToast('ملاحظة القرار إجبارية عند رفض الطلب.', true);
                return;
            }
            if (errorEl) errorEl.classList.add('hidden');
            if (noteInput) noteInput.classList.remove('border-rose-500');

            const formData = new URLSearchParams();
            formData.append('id', id);
            formData.append('isApproved', isApproved);
            formData.append('managerNote', noteVal);

            const res = await fetch('/Dashboard/DecideRequest', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData.toString()
            });

            const data = await res.json();
            if (!data.success) {
                showLiveToast(data.message || 'تعذر تنفيذ القرار.', true);
                return;
            }

            syncCounters(data.pendingCount, data.approvedCount, data.rejectedCount);
            prependRecentDecision(data.id, data.employeeName, data.decisionLabel, data.note, data.timeText);

            const card = document.getElementById('req-card-' + id);
            if (card) {
                card.setAttribute('data-status', data.status);
                card.classList.remove('border-r-amber-500');
                card.classList.add('border-r-blue-600');
                const cb = card.querySelector('.bulk-checkbox');
                if (cb) cb.remove();
            }

            const badge = document.getElementById('req-status-badge-' + id);
            if (badge) {
                badge.innerText = data.status;
                badge.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-bold ' +
                    (isApproved ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800');
            }

            const actionBox = document.getElementById('req-action-box-' + id);
            if (actionBox) {
                actionBox.innerHTML = `
                    <div class="text-xs space-y-1">
                        <p class="font-bold ${isApproved ? 'text-emerald-700' : 'text-rose-700'}">الحالة: ${data.status}</p>
                        <p class="text-slate-600">${data.note}</p>
                    </div>`;
            }

            const notifItem = document.getElementById('notif-item-' + id);
            if (notifItem) notifItem.remove();

            updateBulkCount();
            applyRequestFilters();
            showLiveToast(`تم تسجيل قرار (${data.decisionLabel}) للطلب #${id} فوراً.`);
        }

        function toggleSelectAllPending(masterCb) {
            document.querySelectorAll('.request-item').forEach(card => {
                if (card.style.display === 'none') return;
                const cb = card.querySelector('.bulk-checkbox');
                if (cb) cb.checked = masterCb.checked;
            });
            updateBulkCount();
        }

        function updateBulkCount() {
            const count = document.querySelectorAll('.bulk-checkbox:checked').length;
            const el = document.getElementById('selectedBulkCount');
            if (el) el.innerText = count;
        }

        async function executeBulkApprove() {
            const checkedBoxes = Array.from(document.querySelectorAll('.bulk-checkbox:checked'));
            const ids = checkedBoxes.map(cb => parseInt(cb.value, 10));
            if (ids.length === 0) {
                showLiveToast('يرجى تحديد طلب واحد أو أكثر للموافقة الجماعية.', true);
                return;
            }

            const note = document.getElementById('bulkApprovalNote')?.value || '';
            const res = await fetch('/Dashboard/BulkApprove', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ids, note })
            });

            const data = await res.json();
            if (!data.success) {
                showLiveToast(data.message || 'فشلت الموافقة الجماعية.', true);
                return;
            }

            syncCounters(data.pendingCount, data.approvedCount, data.rejectedCount);

            data.updated.forEach(item => {
                prependRecentDecision(item.id, item.employeeName, 'مقبول (جماعي)', item.note, item.timeText);

                const card = document.getElementById('req-card-' + item.id);
                if (card) {
                    card.setAttribute('data-status', 'Approved');
                    card.classList.remove('border-r-amber-500');
                    card.classList.add('border-r-blue-600');
                    const cb = card.querySelector('.bulk-checkbox');
                    if (cb) cb.remove();
                }

                const badge = document.getElementById('req-status-badge-' + item.id);
                if (badge) {
                    badge.innerText = 'Approved';
                    badge.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-800';
                }

                const actionBox = document.getElementById('req-action-box-' + item.id);
                if (actionBox) {
                    actionBox.innerHTML = `
                        <div class="text-xs space-y-1">
                            <p class="font-bold text-emerald-700">الحالة: Approved</p>
                            <p class="text-slate-600">${item.note}</p>
                        </div>`;
                }

                const notifItem = document.getElementById('notif-item-' + item.id);
                if (notifItem) notifItem.remove();
            });

            const masterCb = document.getElementById('selectAllPending');
            if (masterCb) masterCb.checked = false;
            updateBulkCount();
            applyRequestFilters();
            showLiveToast(`تمت الموافقة الجماعية على ${data.count} طلبات بنجاح.`);
        }

        function toggleNotifications() {
            const box = document.getElementById('notifDropdown');
            if (box) box.classList.toggle('hidden');
        }

        function handleRequestTypeChange() {
            const selectEl = document.getElementById('requestTypeSelect');
            if (!selectEl) return;
            const val = selectEl.value;
            const anonInput = document.getElementById('isAnonymousInput');
            const nameField = document.getElementById('empNameField');
            const dateRangeFields = document.getElementById('dateRangeFields');
            const endDateWrapper = document.getElementById('endDateWrapper');
            const exitTimeWrapper = document.getElementById('exitTimeWrapper');
            const advanceAmountField = document.getElementById('advanceAmountField');
            const salaryRaiseFields = document.getElementById('salaryRaiseFields');

            dateRangeFields?.classList.add('hidden');
            endDateWrapper?.classList.remove('hidden');
            exitTimeWrapper?.classList.add('hidden');
            advanceAmountField?.classList.add('hidden');
            salaryRaiseFields?.classList.add('hidden');

            if (val === 'AnonymousWhistleblowing') {
                if (anonInput) anonInput.value = 'true';
                if (nameField) nameField.style.display = 'none';
            } else {
                if (anonInput) anonInput.value = 'false';
                if (nameField) nameField.style.display = 'block';
            }

            if (val === 'AnnualLeave') {
                dateRangeFields?.classList.remove('hidden');
            } else if (val === 'ExitPermission') {
                dateRangeFields?.classList.remove('hidden');
                endDateWrapper?.classList.add('hidden');
                exitTimeWrapper?.classList.remove('hidden');
            } else if (val === 'SalaryAdvance') {
                advanceAmountField?.classList.remove('hidden');
            } else if (val === 'SalaryRaise') {
                salaryRaiseFields?.classList.remove('hidden');
                updateSalaryCounter();
            }
        }

        function updateSalaryCounter() {
            const cur = parseFloat(document.getElementById('currentSalaryInput')?.value) || 0;
            const raise = parseFloat(document.getElementById('raiseAmountInput')?.value) || 0;
            const newSal = cur + raise;
            const pct = cur > 0 ? ((raise / cur) * 100).toFixed(1) : 0;

            if (document.getElementById('counterNewSalary')) {
                document.getElementById('counterNewSalary').innerText = newSal.toFixed(2);
                document.getElementById('counterRaiseDiff').innerText = '+' + raise.toFixed(2);
                document.getElementById('counterRaisePercent').innerText = pct + '%';
            }
        }

        function activateWhistleblower() {
            const select = document.getElementById('requestTypeSelect');
            if (select) {
                select.value = 'AnonymousWhistleblowing';
                handleRequestTypeChange();
                document.getElementById('employeeFormCard')?.scrollIntoView({ behavior: 'smooth' });
            }
        }

        function openEditModal(id, details, startDate, endDate, exitTime, advanceAmount, curSalary, raiseAmount) {
            document.getElementById('editReqId').value = id;
            document.getElementById('editDetails').value = details;
            document.getElementById('editStartDate').value = startDate;
            document.getElementById('editEndDate').value = endDate;
            document.getElementById('editExitTime').value = exitTime;
            document.getElementById('editAdvanceAmount').value = advanceAmount;
            document.getElementById('editCurrentSalary').value = curSalary;
            document.getElementById('editRaiseAmount').value = raiseAmount;
            document.getElementById('editModal').classList.remove('hidden');
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.add('hidden');
        }

        function filterRequests(status) {
            currentStatusFilter = status;
            document.querySelectorAll('.filter-btn').forEach(btn => {
                if (btn.getAttribute('data-status') === status) {
                    btn.classList.remove('bg-slate-100', 'text-slate-700');
                    btn.classList.add('bg-blue-700', 'text-white');
                } else {
                    btn.classList.remove('bg-blue-700', 'text-white');
                    btn.classList.add('bg-slate-100', 'text-slate-700');
                }
            });
            applyRequestFilters();
        }

        function applyRequestFilters() {
            const searchInput = document.getElementById('requestSearchInput');
            const typeSelect = document.getElementById('typeFilterSelect');
            const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
            const selectedType = typeSelect ? typeSelect.value : 'All';

            document.querySelectorAll('.request-item').forEach(item => {
                const itemStatus = item.getAttribute('data-status');
                const itemType = item.getAttribute('data-type');
                const itemSearch = (item.getAttribute('data-search') || '').toLowerCase();

                const matchesStatus = (currentStatusFilter === 'All' || itemStatus === currentStatusFilter);
                const matchesType = (selectedType === 'All' || itemType === selectedType);
                const matchesSearch = (!query || itemSearch.includes(query));

                item.style.display = (matchesStatus && matchesType && matchesSearch) ? 'block' : 'none';
            });
        }

        function filterAuditLogs() {
            const input = document.getElementById('auditSearchInput');
            const query = input ? input.value.toLowerCase().trim() : '';
            document.querySelectorAll('.audit-row').forEach(row => {
                const text = (row.getAttribute('data-search') || '').toLowerCase();
                row.style.display = (!query || text.includes(query)) ? '' : 'none';
            });
        }

        function openInspectModal(id, emp, dept, type, status, details, note, date) {
            document.getElementById('modalTitle').innerText = 'معاينة الطلب #' + id;
            document.getElementById('modalEmp').innerText = emp;
            document.getElementById('modalDept').innerText = dept;
            document.getElementById('modalType').innerText = type;
            document.getElementById('modalStatus').innerText = status;
            document.getElementById('modalDetails').innerText = details;
            document.getElementById('modalNote').innerText = note;
            document.getElementById('modalDate').innerText = 'تاريخ الإنشاء: ' + date;
            document.getElementById('inspectModal').classList.remove('hidden');
        }

        function closeInspectModal() {
            document.getElementById('inspectModal').classList.add('hidden');
        }

        let lastAssistantQuestion = '';
        let lastAssistantReply = '';
        const activeRoleForUtility = '@currentRole';

        function openUtilityTab(tabName) {
            document.getElementById('utilityDrawer').classList.remove('hidden');
            switchUtilityTab(tabName);
        }

        function closeUtilityDrawer() {
            document.getElementById('utilityDrawer').classList.add('hidden');
        }

        function switchUtilityTab(tabName) {
            document.querySelectorAll('.utab-panel').forEach(p => p.classList.add('hidden'));
            document.getElementById('utab-' + tabName)?.classList.remove('hidden');

            document.querySelectorAll('.utab-btn').forEach(btn => {
                btn.classList.remove('bg-blue-700', 'text-white');
                btn.classList.add('bg-slate-100', 'text-slate-700');
            });
            const activeBtn = document.getElementById('utab-btn-' + tabName);
            if (activeBtn) {
                activeBtn.classList.remove('bg-slate-100', 'text-slate-700');
                activeBtn.classList.add('bg-blue-700', 'text-white');
            }
            if (tabName === 'notes') renderQuickNotes();
        }

        async function createHelpdeskTicket(overrideCat, overridePrio, overrideDesc) {
            const category = overrideCat || document.getElementById('ticketCategory').value;
            const priority = overridePrio || document.getElementById('ticketPriority').value;
            const description = (overrideDesc || document.getElementById('ticketDescription').value || '').trim();

            if (!description) {
                showLiveToast('يرجى كتابة وصف المشكلة أولاً.', true);
                return;
            }

            const body = new URLSearchParams();
            body.append('category', category);
            body.append('priority', priority);
            body.append('description', description);

            const res = await fetch('/Dashboard/SubmitSupportTicket', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                body: body.toString()
            });
            const data = await res.json();
            if (!data.success) {
                showLiveToast(data.message || 'تعذر فتح التذكرة.', true);
                return;
            }

            const t = data.ticket;
            const list = document.getElementById('ticketsListContainer');
            list.insertAdjacentHTML('afterbegin', `
                <div class="bg-white border border-blue-200 rounded-xl p-3 space-y-1">
                    <div class="flex items-center justify-between">
                        <span class="font-extrabold text-blue-700">${t.ticketNo} — ${t.category}</span>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">${t.status}</span>
                    </div>
                    <p class="text-slate-700 text-[11px]">${t.summary}</p>
                    <div class="flex justify-between text-[10px] text-slate-400">
                        <span>الأولوية: ${t.priority}</span>
                        <span>${t.createdAtText}</span>
                    </div>
                </div>`);

            if (!overrideDesc) document.getElementById('ticketDescription').value = '';
            showLiveToast(`تم فتح التذكرة ${t.ticketNo} بنجاح.`);
        }

        function askSmartAssistant(presetPrompt) {
            const input = document.getElementById('assistantInput');
            const prompt = (presetPrompt || input.value || '').trim();
            if (!prompt) return;

            lastAssistantQuestion = prompt;
            if (!presetPrompt) input.value = '';

            const chatBox = document.getElementById('assistantChatBox');
            chatBox.insertAdjacentHTML('beforeend', `
                <div class="bg-blue-700 text-white rounded-xl p-2.5 text-[11px] mr-6">${prompt}</div>`);

            let reply = '';
            if (prompt.includes('الأمنية') || prompt.includes('التدقيق')) {
                reply = 'آخر التغييرات الأمنية تركز على عزل البلاغات السرية عن المدير المباشر، وتقييد رؤية مؤشرات الشركة بالمدير وHR، وتسجيل الحركات الحساسة في سجل التدقيق.';
            } else if (prompt.includes('طلبات الفريق') || prompt.includes('المدير')) {
                reply = 'في لوحة المدير يمكنك البحث بالاسم أو رقم الطلب، الفلترة حسب النوع والحالة، التحقق من تعارض الإجازات، إدخال سبب الرفض الإجباري، أو تنفيذ موافقة جماعية.';
            } else if (prompt.includes('صلاحيات')) {
                reply = `دورك الحالي هو (${activeRoleForUtility}): كل دور يرى البيانات والعمليات المخصصة له فقط لضمان حوكمة البيانات.`;
            } else {
                reply = `بناءً على سياقك الحالي (${activeRoleForUtility})، يمكنك متابعة الإجراءات من القائمة الرئيسية أو تحويل هذا الاستفسار إلى تذكرة دعم فني للمتابعة.`;
            }

            lastAssistantReply = reply;
            chatBox.insertAdjacentHTML('beforeend', `
                <div class="bg-white border border-slate-200 text-slate-800 rounded-xl p-2.5 text-[11px] ml-6 leading-relaxed">${reply}</div>`);
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        function copyLastAssistantReply() {
            if (!lastAssistantReply) {
                showLiveToast('لا يوجد رد لنسخه بعد.', true);
                return;
            }
            navigator.clipboard?.writeText(lastAssistantReply);
            showLiveToast('تم نسخ آخر رد من المساعد الذكي.');
        }

        function escalateAssistantToTicket() {
            const desc = lastAssistantQuestion
                ? `استفسار محوّل من المساعد الذكي: ${lastAssistantQuestion}`
                : 'طلب متابعة بشرية محوّل من المساعد الذكي.';
            switchUtilityTab('helpdesk');
            createHelpdeskTicket('نظام الموارد البشرية', 'متوسطة', desc);
        }

        function filterCenterAlerts(mode) {
            document.querySelectorAll('.calert-tab').forEach(btn => {
                if (btn.getAttribute('data-filter') === mode) {
                    btn.classList.remove('bg-slate-100', 'text-slate-700');
                    btn.classList.add('bg-blue-700', 'text-white');
                } else {
                    btn.classList.remove('bg-blue-700', 'text-white');
                    btn.classList.add('bg-slate-100', 'text-slate-700');
                }
            });

            document.querySelectorAll('.calert-item').forEach(item => {
                const isUnread = item.getAttribute('data-unread') === 'true';
                const isSec = item.getAttribute('data-security') === 'true';
                const show = (mode === 'all') || (mode === 'unread' && isUnread) || (mode === 'security' && isSec);
                item.style.display = show ? 'block' : 'none';
            });
        }

        function markAllCenterAlertsRead() {
            document.querySelectorAll('.calert-item').forEach(item => {
                item.setAttribute('data-unread', 'false');
                item.classList.remove('bg-blue-50/60', 'border-blue-200');
                item.classList.add('bg-slate-50', 'border-slate-200');
            });
            const dot = document.getElementById('utilUnreadDot');
            if (dot) dot.classList.add('hidden');
            showLiveToast('تم تحديد جميع التنبيهات كمقروءة.');
        }

        function clearOldCenterAlerts() {
            document.querySelectorAll('.calert-item[data-old="true"]').forEach(el => el.remove());
            showLiveToast('تم مسح التنبيهات القديمة.');
        }

        const NOTES_STORAGE_KEY = 'smarthr_quick_notes_v1';
        const DRAFT_STORAGE_KEY = 'smarthr_quick_note_draft_v1';

        function autoSaveDraftNote() {
            const val = document.getElementById('quickNoteInput')?.value || '';
            localStorage.setItem(DRAFT_STORAGE_KEY, val);
            const st = document.getElementById('noteAutoSaveStatus');
            if (st) st.innerText = 'تم الحفظ تلقائياً ✓';
        }

        function getSavedNotes() {
            try { return JSON.parse(localStorage.getItem(NOTES_STORAGE_KEY) || '[]'); }
            catch { return []; }
        }

        function saveNotesArray(arr) {
            localStorage.setItem(NOTES_STORAGE_KEY, JSON.stringify(arr));
        }

        function addSavedQuickNote() {
            const input = document.getElementById('quickNoteInput');
            const text = (input?.value || '').trim();
            if (!text) {
                showLiveToast('اكتب ملاحظة أولاً.', true);
                return;
            }
            const notes = getSavedNotes();
            notes.unshift({
                id: Date.now(),
                text,
                pinned: false,
                date: new Date().toLocaleString('ar-JO')
            });
            saveNotesArray(notes);
            input.value = '';
            localStorage.removeItem(DRAFT_STORAGE_KEY);
            renderQuickNotes();
            showLiveToast('تمت إضافة الملاحظة إلى الدفتر.');
        }

        function togglePinNote(id) {
            const notes = getSavedNotes().map(n => n.id === id ? { ...n, pinned: !n.pinned } : n);
            notes.sort((a, b) => (b.pinned ? 1 : 0) - (a.pinned ? 1 : 0));
            saveNotesArray(notes);
            renderQuickNotes();
        }

        function deleteQuickNote(id) {
            const notes = getSavedNotes().filter(n => n.id !== id);
            saveNotesArray(notes);
            renderQuickNotes();
        }

        function convertNoteToTicket(id) {
            const note = getSavedNotes().find(n => n.id === id);
            if (!note) return;
            switchUtilityTab('helpdesk');
            createHelpdeskTicket('عطل فني', 'متوسطة', `إجراء محوّل من ملاحظة: ${note.text}`);
        }

        function renderQuickNotes() {
            const draftInput = document.getElementById('quickNoteInput');
            if (draftInput && !draftInput.value) {
                draftInput.value = localStorage.getItem(DRAFT_STORAGE_KEY) || '';
            }

            const container = document.getElementById('savedNotesList');
            if (!container) return;
            const notes = getSavedNotes();
            notes.sort((a, b) => (b.pinned ? 1 : 0) - (a.pinned ? 1 : 0));

            if (!notes.length) {
                container.innerHTML = '<p class="text-[11px] text-slate-400 text-center py-4">لا توجد ملاحظات محفوظة بعد.</p>';
                return;
            }

            container.innerHTML = notes.map(n => `
                <div class="bg-white border ${n.pinned ? 'border-amber-300 bg-amber-50/40' : 'border-slate-200'} rounded-xl p-3 space-y-2">
                    <div class="flex justify-between items-center text-[10px] text-slate-400">
                        <span>${n.date}</span>
                        ${n.pinned ? '<span class="text-amber-700 font-bold">📌 مثبتة</span>' : ''}
                    </div>
                    <p class="text-[11px] text-slate-800 leading-relaxed">${n.text}</p>
                    <div class="flex items-center justify-between pt-1 border-t border-slate-100 text-[10px] font-bold">
                        <div class="flex gap-2">
                            <button type="button" onclick="togglePinNote(${n.id})" class="text-amber-700 hover:underline">${n.pinned ? 'إلغاء التثبيت' : 'تثبيت'}</button>
                            <button type="button" onclick="deleteQuickNote(${n.id})" class="text-rose-600 hover:underline">حذف</button>
                        </div>
                        <button type="button" onclick="convertNoteToTicket(${n.id})" class="text-blue-700 hover:underline">تحويل إلى تذكرة ←</button>
                    </div>
                </div>`).join('');
        }

        function confirmRoleSwitch(targetRole) {
            if (targetRole === activeRoleForUtility) return true;
            return confirm(`تنبيه: أنت على وشك الانتقال من (${activeRoleForUtility}) إلى بوابة (${targetRole}) بصلاحيات وبيانات مختلفة. هل تريد المتابعة؟`);
        }

        handleRequestTypeChange();
    </script>
</body>
</html>