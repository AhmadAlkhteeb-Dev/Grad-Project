@model SmartHR_Platform.Models.ManagerDashboardViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <script src="https://cdn.tailwindcss.com"></script>
    <title>لوحة المدير</title>
</head>
<body class="bg-slate-950 text-white p-10 font-sans">
    <div class="max-w-2xl mx-auto bg-slate-900 border border-slate-800 p-8 rounded-3xl">
        <span class="bg-indigo-500/20 text-indigo-400 text-xs px-3 py-1 rounded-full font-bold">صلاحية مدير مباشر (Manager)</span>
        <h1 class="text-2xl font-bold mt-4">إدارة الفريق: @Model.ManagerName</h1>
        <p class="text-slate-400 text-sm mt-1">إجمالي أعضاء الفريق تحت إشرافك: @Model.TeamSize موظف</p>
        <div class="mt-6 p-4 bg-slate-950 rounded-xl border border-slate-800">
            <p class="text-sm font-bold text-cyan-400 mb-2">طلبات الفريق المعلقة:</p>
            <p class="text-xs text-slate-500">لا توجد طلبات جديدة تتطلب قرارك حالياً.</p>
        </div>
        <a href="/MultiRole/PublicVisitor" class="block mt-6 text-center text-xs text-slate-500 hover:underline">← العودة للرئيسية العامة</a>
    </div>
</body>
</html>