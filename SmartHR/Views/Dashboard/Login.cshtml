@model SmartHR_Platform.Models.LoginViewModel
@{
    ViewData["Title"] = "تسجيل الدخول | SmartHR Enterprise";
    var demoAccounts = ViewBag.DemoAccounts as IReadOnlyList<SmartHR_Platform.Models.AuthenticatedUserSession>
                       ?? Array.Empty<SmartHR_Platform.Models.AuthenticatedUserSession>();
}

<div class="container py-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-4 p-4">
                <div class="text-center mb-4">
                    <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill mb-2">
                        SmartHR Enterprise
                    </span>
                    <h4 class="fw-bold mb-1">تسجيل الدخول إلى البوابة المؤسسية</h4>
                    <p class="text-muted small mb-0">
                        يتم إنشاء الحسابات إدارياً وفق الدور والصلاحية داخل المنصة
                    </p>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="alert alert-danger small">@Model.ErrorMessage</div>
                }

                <form asp-action="Login" asp-controller="Dashboard" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Identifier" class="form-label fw-semibold"></label>
                        <input asp-for="Identifier" id="loginIdentifier" class="form-control form-control-lg"
                               placeholder="مثال: EMP-101 أو MGR-201 أو HR-301" />
                        <span asp-validation-for="Identifier" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <div class="input-group input-group-lg">
                            <input asp-for="Password" id="loginPassword" type="password" class="form-control"
                                   placeholder="أدخل كلمة المرور" />
                            <button type="button" class="btn btn-outline-secondary" onclick="togglePassword()">
                                إظهار
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold">
                        تسجيل الدخول
                    </button>
                </form>

                @if (demoAccounts.Any())
                {
                    <hr class="my-4" />
                    <div class="small text-muted mb-2 fw-semibold">اختصار تعبئة حسابات الاختبار:</div>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var acc in demoAccounts)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    onclick="fillDemo('@acc.Identifier', '123456')">
                                @acc.Role (@acc.DisplayName)
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    function togglePassword() {
        const input = document.getElementById('loginPassword');
        if (!input) return;
        input.type = input.type === 'password' ? 'text' : 'password';
    }

    function fillDemo(id, pass) {
        const idInput = document.getElementById('loginIdentifier');
        const passInput = document.getElementById('loginPassword');
        if (idInput) idInput.value = id;
        if (passInput) passInput.value = pass;
    }
</script>