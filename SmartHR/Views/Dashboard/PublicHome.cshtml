@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SmartHR Enterprise | منصة الموارد البشرية الذكية</title>

    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background: #f5f7fc;
            color: #172554;
        }

        .hero-bg {
            background: radial-gradient(circle at 10% 20%, rgba(59,130,246,.22), transparent 30%), radial-gradient(circle at 90% 80%, rgba(99,102,241,.20), transparent 30%), linear-gradient(125deg, #0b1735 0%, #142b59 55%, #1e40af 100%);
        }

        .glass {
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.15);
            backdrop-filter: blur(15px);
        }

        .portal-card {
            background: white;
            border: 1px solid #e8edf5;
            border-radius: 20px;
            padding: 25px;
            transition: all .3s ease;
            position: relative;
            overflow: hidden;
        }

            .portal-card:hover {
                transform: translateY(-7px);
                border-color: #93b4ff;
                box-shadow: 0 18px 40px rgba(30,64,175,.12);
            }

            .portal-card::after {
                content: "";
                position: absolute;
                bottom: 0;
                right: 0;
                height: 3px;
                width: 0;
                background: var(--accent);
                transition: width .3s ease;
            }

            .portal-card:hover::after {
                width: 100%;
            }

        .icon-box {
            width: 55px;
            height: 55px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: .3s;
        }

        .portal-card:hover .icon-box {
            transform: scale(1.08);
        }

        .stat-card {
            background: white;
            border: 1px solid #e8edf5;
            border-radius: 18px;
            padding: 23px;
        }

        .dot-pattern {
            background-image: radial-gradient(rgba(255,255,255,.15) 1px, transparent 1px);
            background-size: 23px 23px;
        }

        .nav-link {
            transition: .2s;
        }

            .nav-link:hover {
                color: #2563eb;
            }

        .login-btn {
            transition: .25s;
        }

            .login-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(37,99,235,.25);
            }

        @@media (max-width: 640px) {
            .hero-title {
                font-size: 30px;
            }
        }
    </style>
</head>

<body class="min-h-screen flex flex-col">

    <!-- HEADER -->
    <header class="bg-white sticky top-0 z-50 border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-5 lg:px-10 py-4 flex justify-between items-center gap-4">

            <a href="/" class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-800 flex items-center justify-center text-white shadow-lg">
                    <i data-lucide="building-2" class="w-7 h-7"></i>
                </div>

                <div>
                    <h1 class="text-lg font-black text-slate-900 tracking-tight">
                        SmartHR <span class="text-blue-700">Enterprise</span>
                    </h1>
                    <p class="text-[10px] text-slate-500 font-bold">
                        INTELLIGENT HUMAN CAPITAL MANAGEMENT
                    </p>
                </div>
            </a>

            <nav class="hidden lg:flex items-center gap-8 text-sm font-bold text-slate-600">
                <a href="#home" class="nav-link">الرئيسية</a>
                <a href="#portals" class="nav-link">بوابات النظام</a>
                <a href="#statistics" class="nav-link">المؤشرات</a>
                <a href="#about" class="nav-link">عن المنصة</a>
            </nav>

            <div class="flex items-center gap-2">
                <a href="/Dashboard/Index?role=Employee"
                   class="hidden sm:flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-100 text-slate-700 text-xs font-bold hover:bg-slate-200 transition">
                    <i data-lucide="user" class="w-4 h-4"></i>
                    دخول الموظفين
                </a>

                <a href="/Dashboard/Index?role=HR"
                   class="login-btn flex items-center gap-2 px-4 py-2.5 rounded-xl bg-blue-700 text-white text-xs font-bold">
                    <i data-lucide="shield-check" class="w-4 h-4"></i>
                    بوابة الإدارة
                </a>
            </div>

        </div>
    </header>


    <!-- HERO SECTION -->
    <section id="home" class="hero-bg relative overflow-hidden text-white">

        <div class="absolute inset-0 dot-pattern opacity-40"></div>

        <div class="absolute -top-32 -left-20 w-96 h-96 bg-blue-400/10 rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 right-0 w-96 h-96 bg-indigo-400/10 rounded-full blur-3xl"></div>

        <div class="relative max-w-7xl mx-auto px-6 lg:px-10 py-20 lg:py-24">

            <div class="grid lg:grid-cols-2 gap-14 items-center">

                <div class="text-center lg:text-right">

                    <div class="inline-flex items-center gap-2 glass px-4 py-2 rounded-full text-xs font-bold mb-7">
                        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                        منصة ذكية لإدارة رأس المال البشري
                    </div>

                    <h2 class="hero-title text-4xl lg:text-5xl font-black leading-[1.5] mb-6">
                        نحو بيئة عمل أكثر
                        <span class="text-blue-300">استقراراً وذكاءً</span>
                        <br>
                        بقرارات مبنية على البيانات
                    </h2>

                    <p class="text-blue-100/80 text-sm lg:text-base leading-8 max-w-xl mx-auto lg:mx-0 mb-9">
                        منصة SmartHR Enterprise تمنح المؤسسات رؤية متكاملة لإدارة
                        الموظفين، وتحليل مؤشرات الاستقرار الوظيفي، ومتابعة الطلبات
                        والبلاغات، ودعم اتخاذ القرارات الإدارية بكفاءة وموثوقية.
                    </p>

                    <div class="flex flex-wrap justify-center lg:justify-start gap-3">

                        <a href="#portals"
                           class="login-btn bg-white text-blue-900 px-7 py-3.5 rounded-xl font-extrabold text-sm flex items-center gap-2">
                            استكشف بوابات النظام
                            <i data-lucide="arrow-left" class="w-4 h-4"></i>
                        </a>

                        <a href="/Dashboard/Index?role=Employee"
                           class="glass px-7 py-3.5 rounded-xl font-bold text-sm flex items-center gap-2 hover:bg-white/15 transition">
                            <i data-lucide="log-in" class="w-4 h-4"></i>
                            تسجيل الدخول
                        </a>

                    </div>

                    <div class="flex flex-wrap justify-center lg:justify-start gap-7 mt-12 text-xs text-blue-100/80">

                        <div class="flex items-center gap-2">
                            <i data-lucide="shield-check" class="w-4 h-4 text-emerald-300"></i>
                            حماية البيانات
                        </div>

                        <div class="flex items-center gap-2">
                            <i data-lucide="chart-no-axes-combined" class="w-4 h-4 text-blue-300"></i>
                            تحليلات ذكية
                        </div>

                        <div class="flex items-center gap-2">
                            <i data-lucide="workflow" class="w-4 h-4 text-indigo-300"></i>
                            إدارة متكاملة
                        </div>

                    </div>
                </div>


                <!-- HERO VISUAL -->
                <div class="hidden lg:block relative">

                    <div class="glass rounded-3xl p-7 shadow-2xl relative">

                        <div class="flex justify-between items-center mb-8">
                            <div>
                                <p class="text-xs text-blue-200">لوحة المعلومات المؤسسية</p>
                                <h3 class="text-xl font-black mt-1">نظرة عامة على الأداء</h3>
                            </div>

                            <div class="w-11 h-11 bg-white/10 rounded-xl flex items-center justify-center">
                                <i data-lucide="layout-dashboard" class="w-6 h-6"></i>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-4 mb-5">

                            <div class="bg-white/10 rounded-2xl p-5">
                                <div class="flex justify-between items-center">
                                    <i data-lucide="users" class="w-5 h-5 text-blue-300"></i>
                                    <span class="text-[10px] text-emerald-300">مؤشر توضيحي</span>
                                </div>
                                <p class="text-3xl font-black mt-4">88.4%</p>
                                <p class="text-xs text-blue-100 mt-1">استقرار الكفاءات</p>
                            </div>

                            <div class="bg-white/10 rounded-2xl p-5">
                                <div class="flex justify-between items-center">
                                    <i data-lucide="brain-circuit" class="w-5 h-5 text-indigo-300"></i>
                                    <span class="text-[10px] text-blue-200">تحليلات</span>
                                </div>
                                <p class="text-3xl font-black mt-4">94.2%</p>
                                <p class="text-xs text-blue-100 mt-1">دقة النماذج التحليلية</p>
                            </div>

                        </div>

                        <div class="bg-white/10 rounded-2xl p-5">

                            <div class="flex justify-between mb-5">
                                <span class="font-bold text-sm">مكونات المنصة</span>
                                <i data-lucide="activity" class="w-5 h-5 text-blue-300"></i>
                            </div>

                            <div class="space-y-4">

                                <div>
                                    <div class="flex justify-between text-xs mb-2">
                                        <span>إدارة الموظفين</span>
                                        <span>متكاملة</span>
                                    </div>
                                    <div class="h-2 bg-white/10 rounded-full overflow-hidden">
                                        <div class="h-full w-[90%] bg-blue-300 rounded-full"></div>
                                    </div>
                                </div>

                                <div>
                                    <div class="flex justify-between text-xs mb-2">
                                        <span>تحليل الاستقرار الوظيفي</span>
                                        <span>متكامل</span>
                                    </div>
                                    <div class="h-2 bg-white/10 rounded-full overflow-hidden">
                                        <div class="h-full w-[85%] bg-indigo-300 rounded-full"></div>
                                    </div>
                                </div>

                                <div>
                                    <div class="flex justify-between text-xs mb-2">
                                        <span>حوكمة البيانات</span>
                                        <span>متكاملة</span>
                                    </div>
                                    <div class="h-2 bg-white/10 rounded-full overflow-hidden">
                                        <div class="h-full w-[95%] bg-emerald-300 rounded-full"></div>
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>

                    <div class="absolute -bottom-7 -right-7 glass rounded-2xl p-4 flex items-center gap-3 shadow-xl">
                        <div class="w-11 h-11 bg-emerald-400/20 rounded-xl flex items-center justify-center">
                            <i data-lucide="shield-check" class="w-6 h-6 text-emerald-300"></i>
                        </div>
                        <div>
                            <p class="text-xs font-black">بيئة مؤسسية آمنة</p>
                            <p class="text-[10px] text-blue-200">إدارة الصلاحيات والبيانات</p>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </section>


    <!-- PORTALS SECTION -->
    <main class="flex-1">

        <section id="portals" class="max-w-7xl mx-auto px-6 lg:px-10 py-20">

            <div class="text-center mb-12">

                <span class="text-blue-700 text-xs font-black tracking-wide">
                    SYSTEM ACCESS
                </span>

                <h2 class="text-3xl font-black text-slate-900 mt-3 mb-4">
                    بوابات الوصول إلى المنصة
                </h2>

                <p class="text-sm text-slate-500 max-w-2xl mx-auto leading-7">
                    اختر بوابة الدخول المناسبة للوصول إلى الخدمات والوظائف
                    المخصصة لكل مستوى إداري داخل المؤسسة.
                </p>

                <div class="w-16 h-1 bg-blue-700 rounded-full mx-auto mt-5"></div>

            </div>


            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">

                <!-- EMPLOYEE -->
                <a href="/Dashboard/Index?role=Employee"
                   class="portal-card group"
                   style="--accent:#2563eb">

                    <div class="flex justify-between items-start mb-7">

                        <div class="icon-box bg-blue-50 text-blue-700">
                            <i data-lucide="user-round" class="w-7 h-7"></i>
                        </div>

                        <span class="text-[10px] font-black text-blue-600 bg-blue-50 px-3 py-1.5 rounded-full">
                            01
                        </span>

                    </div>

                    <h3 class="font-black text-lg text-slate-900 mb-3 group-hover:text-blue-700 transition">
                        بوابة الموظف
                    </h3>

                    <p class="text-xs text-slate-500 leading-7 mb-7">
                        تقديم الطلبات الرسمية، متابعة حالة المعاملات،
                        وإرسال البلاغات والملاحظات بسرية.
                    </p>

                    <div class="flex justify-between items-center border-t border-slate-100 pt-4">
                        <span class="text-xs font-extrabold text-blue-700">الدخول للبوابة</span>
                        <i data-lucide="arrow-left" class="w-4 h-4 text-blue-700 group-hover:-translate-x-1 transition"></i>
                    </div>

                </a>


                <!-- MANAGER -->
                <a href="/Dashboard/Index?role=Manager"
                   class="portal-card group"
                   style="--accent:#6366f1">

                    <div class="flex justify-between items-start mb-7">

                        <div class="icon-box bg-indigo-50 text-indigo-700">
                            <i data-lucide="briefcase-business" class="w-7 h-7"></i>
                        </div>

                        <span class="text-[10px] font-black text-indigo-600 bg-indigo-50 px-3 py-1.5 rounded-full">
                            02
                        </span>

                    </div>

                    <h3 class="font-black text-lg text-slate-900 mb-3 group-hover:text-indigo-700 transition">
                        المدير المباشر
                    </h3>

                    <p class="text-xs text-slate-500 leading-7 mb-7">
                        مراجعة طلبات الفريق، متابعة الإشعارات،
                        وإدارة الإجراءات والقرارات الإدارية.
                    </p>

                    <div class="flex justify-between items-center border-t border-slate-100 pt-4">
                        <span class="text-xs font-extrabold text-indigo-700">الدخول للبوابة</span>
                        <i data-lucide="arrow-left" class="w-4 h-4 text-indigo-700 group-hover:-translate-x-1 transition"></i>
                    </div>

                </a>


                <!-- HR -->
                <a href="/Dashboard/Index?role=HR"
                   class="portal-card group"
                   style="--accent:#059669">

                    <div class="flex justify-between items-start mb-7">

                        <div class="icon-box bg-emerald-50 text-emerald-700">
                            <i data-lucide="users-round" class="w-7 h-7"></i>
                        </div>

                        <span class="text-[10px] font-black text-emerald-600 bg-emerald-50 px-3 py-1.5 rounded-full">
                            03
                        </span>

                    </div>

                    <h3 class="font-black text-lg text-slate-900 mb-3 group-hover:text-emerald-700 transition">
                        الموارد البشرية
                    </h3>

                    <p class="text-xs text-slate-500 leading-7 mb-7">
                        متابعة مؤشرات الاستقرار المؤسسي،
                        إعداد التقارير التنفيذية وإدارة البلاغات.
                    </p>

                    <div class="flex justify-between items-center border-t border-slate-100 pt-4">
                        <span class="text-xs font-extrabold text-emerald-700">الدخول للبوابة</span>
                        <i data-lucide="arrow-left" class="w-4 h-4 text-emerald-700 group-hover:-translate-x-1 transition"></i>
                    </div>

                </a>


                <!-- ADMIN -->
                <a href="/Dashboard/Index?role=Admin"
                   class="portal-card group"
                   style="--accent:#475569">

                    <div class="flex justify-between items-start mb-7">

                        <div class="icon-box bg-slate-100 text-slate-700">
                            <i data-lucide="settings-2" class="w-7 h-7"></i>
                        </div>

                        <span class="text-[10px] font-black text-slate-600 bg-slate-100 px-3 py-1.5 rounded-full">
                            04
                        </span>

                    </div>

                    <h3 class="font-black text-lg text-slate-900 mb-3 group-hover:text-slate-700 transition">
                        مدير النظام
                    </h3>

                    <p class="text-xs text-slate-500 leading-7 mb-7">
                        إدارة صلاحيات المستخدمين،
                        مراقبة سجل التدقيق وحوكمة الوصول للبيانات.
                    </p>

                    <div class="flex justify-between items-center border-t border-slate-100 pt-4">
                        <span class="text-xs font-extrabold text-slate-700">الدخول للبوابة</span>
                        <i data-lucide="arrow-left" class="w-4 h-4 text-slate-700 group-hover:-translate-x-1 transition"></i>
                    </div>

                </a>

            </div>

        </section>


        <!-- STATISTICS -->
        <section id="statistics" class="bg-white border-y border-slate-200">

            <div class="max-w-7xl mx-auto px-6 lg:px-10 py-16">

                <div class="text-center mb-10">
                    <span class="text-blue-700 text-xs font-black">SMART INSIGHTS</span>
                    <h2 class="text-2xl font-black text-slate-900 mt-3">
                        مؤشرات الأداء المؤسسي
                    </h2>
                    <p class="text-xs text-slate-500 mt-2">
                        مؤشرات توضيحية لعرض إمكانيات المنصة التحليلية
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-5">

                    <div class="stat-card text-center">
                        <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-700 flex items-center justify-center mx-auto mb-4">
                            <i data-lucide="brain-circuit" class="w-6 h-6"></i>
                        </div>

                        <p class="text-xs font-bold text-slate-500">دقة النماذج التحليلية</p>
                        <p class="text-4xl font-black text-slate-900 mt-3">94.2%</p>
                        <p class="text-[10px] text-slate-400 mt-2">مؤشر توضيحي</p>
                    </div>

                    <div class="stat-card text-center">
                        <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center mx-auto mb-4">
                            <i data-lucide="trending-up" class="w-6 h-6"></i>
                        </div>

                        <p class="text-xs font-bold text-slate-500">استقرار الكفاءات</p>
                        <p class="text-4xl font-black text-emerald-700 mt-3">88.4%</p>
                        <p class="text-[10px] text-slate-400 mt-2">مؤشر توضيحي</p>
                    </div>

                    <div class="stat-card text-center">
                        <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-700 flex items-center justify-center mx-auto mb-4">
                            <i data-lucide="shield-check" class="w-6 h-6"></i>
                        </div>

                        <p class="text-xs font-bold text-slate-500">حوكمة البيانات والخصوصية</p>
                        <p class="text-2xl font-black text-indigo-700 mt-4">إدارة آمنة</p>
                        <p class="text-[10px] text-slate-400 mt-3">وفق إعدادات النظام الفعلية</p>
                    </div>

                </div>

            </div>
        </section>


        <!-- ABOUT -->
        <section id="about" class="max-w-7xl mx-auto px-6 lg:px-10 py-16">

            <div class="bg-gradient-to-l from-blue-900 to-indigo-800 rounded-3xl p-8 lg:p-12 text-white flex flex-col lg:flex-row items-center justify-between gap-8">

                <div>
                    <span class="text-blue-200 text-xs font-bold">SMART HR SOLUTIONS</span>
                    <h2 class="text-2xl lg:text-3xl font-black mt-3 mb-4">
                        الموارد البشرية تبدأ بقرارات أكثر ذكاءً
                    </h2>
                    <p class="text-blue-100 text-sm leading-8 max-w-2xl">
                        نجمع بين الإدارة الرقمية والتحليل الذكي لتوفير بيئة
                        مؤسسية تدعم الموظفين، وتمكّن الإدارات من اتخاذ قرارات
                        أكثر دقة وفاعلية.
                    </p>
                </div>

                <a href="/Dashboard/Index?role=HR"
                   class="shrink-0 bg-white text-blue-900 px-7 py-3.5 rounded-xl text-sm font-black hover:bg-blue-50 transition">
                    استكشف لوحة الإدارة
                </a>

            </div>

        </section>

    </main>


    <!-- FOOTER -->
    <footer class="bg-slate-950 text-white">

        <div class="max-w-7xl mx-auto px-6 lg:px-10 py-8">

            <div class="flex flex-col md:flex-row justify-between items-center gap-5">

                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-blue-700 rounded-xl flex items-center justify-center">
                        <i data-lucide="building-2" class="w-5 h-5"></i>
                    </div>

                    <div>
                        <p class="font-black text-sm">SmartHR Enterprise</p>
                        <p class="text-[10px] text-slate-400">منصة إدارة واستقرار الموارد البشرية</p>
                    </div>
                </div>

                <p class="text-xs text-slate-400 text-center">
                    جميع الحقوق محفوظة © 2026 SmartHR Enterprise
                </p>

                <div class="flex items-center gap-2 text-xs text-emerald-400">
                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                    منصة الإدارة الذكية
                </div>

            </div>

        </div>

    </footer>


    <script>
        lucide.createIcons();
    </script>

</body>
</html>
